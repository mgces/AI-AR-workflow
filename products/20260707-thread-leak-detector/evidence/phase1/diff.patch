+ */
+HWTEST_F(ThreadLeakDetectorUnitTest, ThreadLeakConfigClassify001, TestSize.Level1)
+{
+    EXPECT_EQ(ThreadLeakConfig::GetWarningThreshold(), DEFAULT_WARNING_THRESHOLD);
+    EXPECT_EQ(ThreadLeakConfig::GetFaultThreshold(), DEFAULT_FAULT_THRESHOLD);
+    EXPECT_EQ(ThreadLeakConfig::Classify(1999), ThreadLeakLevel::NORMAL);
+    EXPECT_EQ(ThreadLeakConfig::Classify(2000), ThreadLeakLevel::WARNING);
+    EXPECT_EQ(ThreadLeakConfig::Classify(2999), ThreadLeakLevel::WARNING);
+    EXPECT_EQ(ThreadLeakConfig::Classify(3000), ThreadLeakLevel::FAULT);
+    EXPECT_EQ(ThreadLeakConfig::Classify(9000), ThreadLeakLevel::FAULT);
+    EXPECT_EQ(ThreadLeakConfig::Classify(-1), ThreadLeakLevel::NORMAL);
+}
+
+/**
+ * @tc.name: ThreadLeakConfigClassify002
+ * @tc.desc: thresholds are overridable at runtime via system parameters
+ * @tc.type: FUNC
+ */
+HWTEST_F(ThreadLeakDetectorUnitTest, ThreadLeakConfigClassify002, TestSize.Level1)
+{
+    OHOS::system::SetParameter(PARAM_WARNING_THRESHOLD, "50");
+    OHOS::system::SetParameter(PARAM_FAULT_THRESHOLD, "100");
+    EXPECT_EQ(ThreadLeakConfig::Classify(10), ThreadLeakLevel::NORMAL);
+    EXPECT_EQ(ThreadLeakConfig::Classify(60), ThreadLeakLevel::WARNING);
+    EXPECT_EQ(ThreadLeakConfig::Classify(150), ThreadLeakLevel::FAULT);
+}
+
+/**
+ * @tc.name: ThreadLeakDecideNormal001
+ * @tc.desc: dropping below the warning line forgets the process, no conclusion, no event
+ * @tc.type: FUNC
+ */
+HWTEST_F(ThreadLeakDetectorUnitTest, ThreadLeakDecideNormal001, TestSize.Level1)
+{
+    ProcessTrackInfo prev;
+    prev.level = ThreadLeakLevel::WARNING;
+    prev.warningTmpFile = "/data/log/reliability/resource_leak/thread_leak/tmp/x.txt";
+    ThreadLeakDecision d = ThreadLeakDetector::Decide(prev, ThreadLeakLevel::NORMAL);
+    EXPECT_TRUE(d.dropTracking);
+    EXPECT_FALSE(d.collect);
+    EXPECT_FALSE(d.reportEvent);
+    EXPECT_FALSE(d.generateConclusion);
+}
+
+/**
+ * @tc.name: ThreadLeakDecideWarning001
+ * @tc.desc: warning collects and refreshes the tmp log but never reports or concludes
+ * @tc.type: FUNC
+ */
+HWTEST_F(ThreadLeakDetectorUnitTest, ThreadLeakDecideWarning001, TestSize.Level1)
+{
+    ProcessTrackInfo prev;
+    prev.level = ThreadLeakLevel::NORMAL;
+    ThreadLeakDecision d = ThreadLeakDetector::Decide(prev, ThreadLeakLevel::WARNING);
+    EXPECT_TRUE(d.collect);
+    EXPECT_TRUE(d.refreshWarningLog);
+    EXPECT_FALSE(d.generateConclusion);
+    EXPECT_FALSE(d.reportEvent);
+    EXPECT_FALSE(d.dropTracking);
+}
+
+/**
+ * @tc.name: ThreadLeakDecideFault001
+ * @tc.desc: direct-to-fault collects, generates the conclusion and reports the event
+ * @tc.type: FUNC
+ */
+HWTEST_F(ThreadLeakDetectorUnitTest, ThreadLeakDecideFault001, TestSize.Level1)
+{
+    ProcessTrackInfo prev; // fresh: NORMAL, not reported
+    ThreadLeakDecision d = ThreadLeakDetector::Decide(prev, ThreadLeakLevel::FAULT);
+    EXPECT_TRUE(d.collect);
+    EXPECT_TRUE(d.generateConclusion);
+    EXPECT_TRUE(d.reportEvent);
+}
+
+/**
+ * @tc.name: ThreadLeakDecideFault002
+ * @tc.desc: fault after a warning still concludes and reports (warning snapshot gets merged)
+ * @tc.type: FUNC
+ */
+HWTEST_F(ThreadLeakDetectorUnitTest, ThreadLeakDecideFault002, TestSize.Level1)
+{
+    ProcessTrackInfo prev;
+    prev.level = ThreadLeakLevel::WARNING;
+    prev.warningTmpFile = "/data/log/reliability/resource_leak/thread_leak/tmp/warn.txt";
+    ThreadLeakDecision d = ThreadLeakDetector::Decide(prev, ThreadLeakLevel::FAULT);
+    EXPECT_TRUE(d.collect);
+    EXPECT_TRUE(d.generateConclusion);
+    EXPECT_TRUE(d.reportEvent);
+}
+
+/**
+ * @tc.name: ThreadLeakDecideFaultOnce001
+ * @tc.desc: an already-reported fault episode is collected only once ("触发一次")
+ * @tc.type: FUNC
+ */
+HWTEST_F(ThreadLeakDetectorUnitTest, ThreadLeakDecideFaultOnce001, TestSize.Level1)
+{
+    ProcessTrackInfo prev;
+    prev.level = ThreadLeakLevel::FAULT;
+    prev.faultReported = true;
+    ThreadLeakDecision d = ThreadLeakDetector::Decide(prev, ThreadLeakLevel::FAULT);
+    EXPECT_FALSE(d.collect);
+    EXPECT_FALSE(d.reportEvent);
+    EXPECT_FALSE(d.generateConclusion);
+}
+
+/**
+ * @tc.name: ThreadLeakUtilProc001
+ * @tc.desc: thread count and per-thread states can be read for the current process
+ * @tc.type: FUNC
+ */
+HWTEST_F(ThreadLeakDetectorUnitTest, ThreadLeakUtilProc001, TestSize.Level1)
+{
+    int32_t self = static_cast<int32_t>(getpid());
+    EXPECT_GE(ThreadLeakUtil::GetThreadCount(self), 1);
+    EXPECT_FALSE(ThreadLeakUtil::GetThreadRunStates(self).empty());
