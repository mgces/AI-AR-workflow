+#ifndef THREAD_LEAK_UTIL_H
+#define THREAD_LEAK_UTIL_H
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace OHOS {
+namespace HiviewDFX {
+// Run state of a single thread as read from /proc/<pid>/task/<tid>/stat.
+struct ThreadRunState {
+    int32_t tid{0};
+    std::string name;
+    char state{'?'}; // R/S/D/Z/T ... from the scheduler
+};
+
+class ThreadLeakUtil {
+public:
+    // Enumerate all live process ids under /proc.
+    static std::vector<int32_t> GetAllProcessPids();
+
+    // Read the thread count of a process from /proc/<pid>/status ("Threads:"). Returns -1 on error.
+    static int32_t GetThreadCount(int32_t pid);
+
+    // Read the per-thread run state for all threads of a process from /proc/<pid>/task.
+    static std::vector<ThreadRunState> GetThreadRunStates(int32_t pid);
+
+    // Ensure the thread_leak root and tmp directories exist (best effort).
+    static bool EnsureLogDirs();
+
+    // Build a tmp-log path for a given level ("warning"/"fault") and process, using a monotonic seq.
+    static std::string BuildTmpLogPath(const std::string &levelTag, int32_t pid, uint64_t seq);
+
+    // Build a conclusion-log path for a process using a monotonic seq.
+    static std::string BuildConclusionLogPath(const std::string &processName, int32_t pid, uint64_t seq);
+
+    // Read a whole file into a string (best effort, capped). Returns empty on error.
+    static std::string ReadFileToString(const std::string &path, size_t maxSize);
+
+    // Sanitize a process name so it is safe to embed in a file name.
+    static std::string SanitizeName(const std::string &name);
+};
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // THREAD_LEAK_UTIL_H
