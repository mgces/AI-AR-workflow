+
+namespace OHOS {
+namespace HiviewDFX {
+REGISTER(ThreadLeakDetectorPlugin);
+DEFINE_LOG_TAG("ThreadLeakDetector");
+
+namespace {
+constexpr uint64_t US_PER_SEC = 1000 * 1000;
+}
+
+void ThreadLeakDetectorPlugin::OnLoad()
+{
+    SetName("ThreadLeakDetectorPlugin");
+    SetVersion("ThreadLeakDetectorPlugin1.0");
+    HIVIEW_LOGI("ThreadLeakDetectorPlugin OnLoad");
+
+    isLoopContinue_ = true;
+    uint64_t intervalSec = ThreadLeakConfig::GetPollIntervalSec();
+    auto pollLoop = [this, intervalSec]() {
+        HIVIEW_LOGI("thread leak poll loop start, interval=%{public}llus",
+                    static_cast<unsigned long long>(intervalSec));
+        while (isLoopContinue_) {
+            ThreadLeakDetector::GetInstance().MainProcess();
+            ffrt::this_task::sleep_for(std::chrono::microseconds(intervalSec * US_PER_SEC));
+        }
+    };
+    pollTaskHandle_ = ffrt::submit_h(pollLoop);
+}
+
+void ThreadLeakDetectorPlugin::OnUnload()
+{
+    isLoopContinue_ = false;
+    if (pollTaskHandle_ != nullptr) {
+        ffrt::wait({pollTaskHandle_});
+    }
+    HIVIEW_LOGI("ThreadLeakDetectorPlugin OnUnload");
+}
+
+bool ThreadLeakDetectorPlugin::OnEvent(std::shared_ptr<Event> &event)
+{
+    return true;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
