+#ifndef THREAD_LEAK_COLLECTOR_H
+#define THREAD_LEAK_COLLECTOR_H
+
+#include <string>
+
+#include "thread_leak_common.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+// Gathers the four kinds of maintenance information required when a thread-count threshold is
+// crossed. Every collector degrades gracefully: an unavailable SA yields a note in the report
+// rather than a failure, so a partial report is always produced.
+class ThreadLeakCollector {
+public:
+    // 1. process identity + foreground/background state.
+    static ProcessBasicInfo CollectBasicInfo(int32_t pid);
+
+    // 2. per-process thread maintenance via the hidumper SA (hidumper -p <pid> --thread).
+    static std::string CollectHidumperThreadDump(int32_t pid);
+
+    // 3. per-thread run state and per-thread CPU run time.
+    static std::string CollectThreadRunStates(int32_t pid);
+
+    // 4. current application call stack via LogCatcherUtils::DumpStacktrace.
+    static std::string CollectStackTrace(int32_t pid);
+
+    // Assemble the full maintenance report text for one threshold crossing.
+    static std::string BuildMaintenanceReport(const ProcessBasicInfo &info, ThreadLeakLevel level);
+};
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // THREAD_LEAK_COLLECTOR_H
