+ * limitations under the License.
+ */
+#include "thread_leak_util.h"
+
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <dirent.h>
+
+#include "file_util.h"
+#include "hiview_logger.h"
+#include "thread_leak_common.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+DEFINE_LOG_TAG("ThreadLeakDetector");
+
+namespace {
+constexpr mode_t THREAD_LEAK_DIR_MODE = S_IRWXU | S_IRWXG; // 0770
+constexpr size_t BUF_SIZE_512 = 512;
+constexpr size_t BUF_SIZE_4096 = 4096;
+const std::string PROC_DIR = "/proc";
+
+bool IsNumeric(const std::string &str)
+{
+    if (str.empty()) {
+        return false;
+    }
+    for (char ch : str) {
+        if (!std::isdigit(static_cast<unsigned char>(ch))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Extract the state char from a /proc/.../stat line: "pid (comm) state ...".
+// comm may itself contain ')' and spaces, so scan from the last ')'.
+char ParseStateFromStat(const std::string &statLine)
+{
+    constexpr std::string::size_type stateOffsetAfterRparen = 2; // skip ") " to reach the state char
+    std::string::size_type rparen = statLine.rfind(')');
+    if (rparen == std::string::npos || rparen + stateOffsetAfterRparen >= statLine.size()) {
+        return '?';
+    }
+    return statLine[rparen + stateOffsetAfterRparen];
+}
+
+std::string ParseCommFromStat(const std::string &statLine)
+{
+    std::string::size_type lparen = statLine.find('(');
+    std::string::size_type rparen = statLine.rfind(')');
+    if (lparen == std::string::npos || rparen == std::string::npos || rparen <= lparen) {
+        return "";
+    }
+    return statLine.substr(lparen + 1, rparen - lparen - 1);
+}
+} // namespace
+
+std::vector<int32_t> ThreadLeakUtil::GetAllProcessPids()
+{
+    std::vector<int32_t> pids;
+    DIR *dir = opendir(PROC_DIR.c_str());
+    if (dir == nullptr) {
+        HIVIEW_LOGE("failed to open %{public}s", PROC_DIR.c_str());
+        return pids;
+    }
+    struct dirent *entry = nullptr;
+    while ((entry = readdir(dir)) != nullptr) {
+        std::string name(entry->d_name);
+        if (!IsNumeric(name)) {
+            continue;
+        }
+        pids.push_back(static_cast<int32_t>(std::strtol(name.c_str(), nullptr, 10))); // 10: decimal
+    }
+    closedir(dir);
+    return pids;
+}
+
+int32_t ThreadLeakUtil::GetThreadCount(int32_t pid)
+{
+    std::string path = PROC_DIR + "/" + std::to_string(pid) + "/status";
+    std::string content = ReadFileToString(path, BUF_SIZE_4096);
+    if (content.empty()) {
+        return -1;
+    }
+    const std::string key = "Threads:";
+    std::string::size_type pos = content.find(key);
+    if (pos == std::string::npos) {
+        return -1;
+    }
+    pos += key.size();
+    return static_cast<int32_t>(std::strtol(content.c_str() + pos, nullptr, 10)); // 10: decimal
+}
+
+std::vector<ThreadRunState> ThreadLeakUtil::GetThreadRunStates(int32_t pid)
+{
+    std::vector<ThreadRunState> states;
+    std::string taskPath = PROC_DIR + "/" + std::to_string(pid) + "/task";
+    DIR *dir = opendir(taskPath.c_str());
+    if (dir == nullptr) {
+        return states;
+    }
+    struct dirent *entry = nullptr;
+    while ((entry = readdir(dir)) != nullptr) {
+        std::string tidStr(entry->d_name);
+        if (!IsNumeric(tidStr)) {
+            continue;
+        }
+        std::string statPath = taskPath + "/" + tidStr + "/stat";
+        std::string statLine = ReadFileToString(statPath, BUF_SIZE_4096);
+        if (statLine.empty()) {
+            continue;
+        }
+        ThreadRunState st;
+        st.tid = static_cast<int32_t>(std::strtol(tidStr.c_str(), nullptr, 10)); // 10: decimal
+        st.name = ParseCommFromStat(statLine);
+        st.state = ParseStateFromStat(statLine);
+        states.push_back(st);
+    }
+    closedir(dir);
+    return states;
+}
+
+bool ThreadLeakUtil::EnsureLogDirs()
+{
+    if (!FileUtil::FileExists(THREAD_LEAK_ROOT_DIR) &&
+        !FileUtil::ForceCreateDirectory(THREAD_LEAK_ROOT_DIR, THREAD_LEAK_DIR_MODE)) {
+        HIVIEW_LOGE("failed to create %{public}s", THREAD_LEAK_ROOT_DIR.c_str());
+        return false;
+    }
+    if (!FileUtil::FileExists(THREAD_LEAK_TMP_DIR) &&
+        !FileUtil::ForceCreateDirectory(THREAD_LEAK_TMP_DIR, THREAD_LEAK_DIR_MODE)) {
+        HIVIEW_LOGE("failed to create %{public}s", THREAD_LEAK_TMP_DIR.c_str());
+        return false;
+    }
+    return true;
+}
+
+std::string ThreadLeakUtil::BuildTmpLogPath(const std::string &levelTag, int32_t pid, uint64_t seq)
+{
+    return THREAD_LEAK_TMP_DIR + "/thread_leak_" + levelTag + "_" + std::to_string(pid) + "_" + std::to_string(seq) +
+           ".txt";
+}
+
+std::string ThreadLeakUtil::BuildConclusionLogPath(const std::string &processName, int32_t pid, uint64_t seq)
+{
+    return THREAD_LEAK_ROOT_DIR + "/thread_leak_" + SanitizeName(processName) + "_" + std::to_string(pid) + "_" +
+           std::to_string(seq) + ".txt";
+}
+
+std::string ThreadLeakUtil::ReadFileToString(const std::string &path, size_t maxSize)
+{
+    FILE *fp = fopen(path.c_str(), "re"); // "e": O_CLOEXEC
+    if (fp == nullptr) {
+        return "";
+    }
+    std::string content;
+    char buf[BUF_SIZE_512] = {0};
+    size_t readLen = 0;
+    while ((readLen = fread(buf, 1, sizeof(buf), fp)) > 0) {
+        content.append(buf, readLen);
+        if (content.size() >= maxSize) {
+            content.resize(maxSize);
+            break;
+        }
+    }
+    (void)fclose(fp);
+    return content;
+}
+
+std::string ThreadLeakUtil::SanitizeName(const std::string &name)
+{
+    std::string result;
+    for (char ch : name) {
+        if (std::isalnum(static_cast<unsigned char>(ch)) || ch == '_' || ch == '.' || ch == '-') {
+            result.push_back(ch);
+        } else {
+            result.push_back('_');
+        }
+    }
+    if (result.empty()) {
+        result = "unknown";
+    }
+    return result;
+}
