+#ifndef THREAD_LEAK_DETECTOR_H
+#define THREAD_LEAK_DETECTOR_H
+
+#include <map>
+#include <mutex>
+#include <string>
+
+#include "singleton.h"
+#include "thread_leak_common.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+// Outcome of one threshold evaluation, exposed as a pure function for unit testing the state machine
+// (no /proc, no IPC): it encodes the dedup and "collect-once-per-fault" rules from the requirement.
+struct ThreadLeakDecision {
+    bool collect{false};            // gather maintenance info this tick
+    bool refreshWarningLog{false};  // rewrite the warning tmp log, discarding the previous one
+    bool generateConclusion{false}; // merge warning+fault into a conclusion file
+    bool reportEvent{false};        // raise the hisysevent fault event
+    bool dropTracking{false};       // process fell back to normal; forget it
+};
+
+class ThreadLeakDetector : public OHOS::DelayedRefSingleton<ThreadLeakDetector> {
+    DECLARE_DELAYED_REF_SINGLETON(ThreadLeakDetector);
+
+public:
+    // One polling tick: scan every process and drive its state machine.
+    void MainProcess();
+
+    // Pure state-machine decision used by MainProcess and exercised directly by unit tests.
+    static ThreadLeakDecision Decide(const ProcessTrackInfo &prev, ThreadLeakLevel newLevel);
+
+private:
+    void HandleProcess(int32_t pid, int32_t threadCount, ThreadLeakLevel level);
+    void HandleWarning(int32_t pid, int32_t threadCount, ProcessTrackInfo &track);
+    void HandleFault(int32_t pid, int32_t threadCount, ProcessTrackInfo &track);
+    void CleanupDeadProcesses(const std::map<int32_t, bool> &livePids);
+    void RemoveWarningTmp(ProcessTrackInfo &track);
+    void ReportThreadLeakEvent(const ProcessBasicInfo &info, const std::string &conclusionPath);
+    void KillBackgroundAppIfNeeded(const ProcessBasicInfo &info);
+    uint64_t NextSeq();
+
+private:
+    std::mutex mutex_;
+    std::map<int32_t, ProcessTrackInfo> trackMap_;
+    uint64_t seq_{0};
+};
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // THREAD_LEAK_DETECTOR_H
