+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "thread_leak_detector_module_test.h"
+
+#include <atomic>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+#include <pthread.h>
+#include <sys/wait.h>
+
+#include "file_util.h"
+#include "hiview_logger.h"
+#include "parameters.h"
+#include "thread_leak_common.h"
+#include "thread_leak_config.h"
+#include "thread_leak_detector.h"
+#include "thread_leak_util.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+DEFINE_LOG_TAG("ThreadLeakDetectorModuleTest");
+using namespace testing::ext;
+
+namespace {
+// This module test exercises the detector at the REAL production thresholds (warning 2000 /
+// fault 3000). Crucially it points the detector at an EXTERNAL child-victim process, exactly as the
+// plugin does in production, rather than dumping the test process's own thousands of threads (a
+// self-dump of that scale wedges the caller). The child grows in two stages so the whole
+// warning -> fault merge path is validated end to end at genuine limits.
+constexpr int WARNING_BAND_THREADS = 2100; // > warning(2000), < fault(3000)
+constexpr int FAULT_BAND_THREADS = 3100;   // > fault(3000)
+constexpr size_t SMALL_THREAD_STACK = 32 * 1024;
+constexpr int SETTLE_US = 300 * 1000;
+constexpr int POLL_US = 100 * 1000;
+constexpr int IDLE_TICK_US = 100 * 1000; // idle thread wakeup interval
+constexpr int SPAWN_GAP_US = 500;        // gap between thread creations while growing
+constexpr int MAX_POLL = 600;            // up to ~60s to reach a target thread count
+
+std::atomic<bool> *g_childKeepRunning = nullptr;
+
+void *IdleThread(void *arg)
+{
+    (void)arg;
+    while (g_childKeepRunning != nullptr && g_childKeepRunning->load()) {
+        usleep(IDLE_TICK_US);
+    }
+    return nullptr;
+}
+
+void ChildGrowTo(int target)
+{
+    int self = static_cast<int>(getpid());
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, SMALL_THREAD_STACK);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    while (ThreadLeakUtil::GetThreadCount(self) < target) {
+        pthread_t t;
+        if (pthread_create(&t, &attr, IdleThread, nullptr) != 0) {
+            break;
+        }
+        usleep(SPAWN_GAP_US);
+    }
+    pthread_attr_destroy(&attr);
+}
+
+// Child victim body: grow to the warning band, wait for a go byte, grow to the fault band, wait for
+// the exit byte. Communicates with the parent purely through a pipe (async-signal free).
+[[noreturn]] void RunChildVictim(int readFd)
+{
+    static std::atomic<bool> keepRunning{true};
+    g_childKeepRunning = &keepRunning;
+    ChildGrowTo(WARNING_BAND_THREADS);
+    char b = 0;
+    (void)read(readFd, &b, 1); // wait for "grow to fault" signal
+    ChildGrowTo(FAULT_BAND_THREADS);
+    (void)read(readFd, &b, 1); // wait for "exit" signal
+    _exit(0);
+}
+
+bool WaitForThreadCount(int pid, int target)
+{
+    for (int i = 0; i < MAX_POLL; i++) {
+        if (ThreadLeakUtil::GetThreadCount(pid) >= target) {
+            return true;
+        }
+        usleep(POLL_US);
+    }
+    return false;
+}
+
+std::string FindConclusion()
+{
+    std::vector<std::string> files;
+    FileUtil::GetDirFiles(THREAD_LEAK_ROOT_DIR, files, false);
+    for (const auto &f : files) {
+        if (f.find("/tmp/") == std::string::npos && f.find(".txt") != std::string::npos) {
+            return f;
+        }
+    }
+    return "";
+}
+} // namespace
+
+void ThreadLeakDetectorModuleTest::SetUpTestCase(void) {}
+
+void ThreadLeakDetectorModuleTest::TearDownTestCase(void) {}
+
+void ThreadLeakDetectorModuleTest::SetUp(void)
+{
+    OHOS::system::SetParameter(PARAM_WARNING_THRESHOLD, std::to_string(DEFAULT_WARNING_THRESHOLD));
+    OHOS::system::SetParameter(PARAM_FAULT_THRESHOLD, std::to_string(DEFAULT_FAULT_THRESHOLD));
+    OHOS::system::SetParameter(PARAM_FOCUS_PID, "0");
+    (void)FileUtil::ForceRemoveDirectory(THREAD_LEAK_ROOT_DIR);
+}
+
+void ThreadLeakDetectorModuleTest::TearDown(void)
+{
+    OHOS::system::SetParameter(PARAM_FOCUS_PID, "0");
+}
+
+/**
+ * @tc.name: ThreadLeakDetectorModuleTest001
+ * @tc.desc: At the real thresholds (2000/3000), an external process that first enters the warning
+ *           band and then the fault band makes the detector produce a merged conclusion log
+ *           (WARNING + FAULT snapshots) containing all four maintenance sections, and no conclusion
+ *           while it is only in the warning band.
+ * @tc.type: FUNC
+ */
+HWTEST_F(ThreadLeakDetectorModuleTest, ThreadLeakDetectorModuleTest001, TestSize.Level2)
+{
+    ASSERT_EQ(ThreadLeakConfig::GetWarningThreshold(), DEFAULT_WARNING_THRESHOLD);
+    ASSERT_EQ(ThreadLeakConfig::GetFaultThreshold(), DEFAULT_FAULT_THRESHOLD);
+
+    int pipeFds[2] = {-1, -1};
+    ASSERT_EQ(pipe(pipeFds), 0);
+    pid_t child = fork();
+    ASSERT_GE(child, 0);
+    if (child == 0) {
+        close(pipeFds[1]);
+        RunChildVictim(pipeFds[0]);
+    }
+    close(pipeFds[0]);
+
+    // Phase 1: child in the warning band only -> a warning tmp log, but NO conclusion yet.
+    ASSERT_TRUE(WaitForThreadCount(child, DEFAULT_WARNING_THRESHOLD));
+    OHOS::system::SetParameter(PARAM_FOCUS_PID, std::to_string(child));
+    usleep(SETTLE_US);
+    ThreadLeakDetector::GetInstance().MainProcess();
+    EXPECT_TRUE(FindConclusion().empty());
+
+    // Phase 2: grow the child into the fault band -> merged conclusion + reported event.
+    ssize_t wrote = write(pipeFds[1], "g", 1);
+    EXPECT_EQ(wrote, 1);
+    ASSERT_TRUE(WaitForThreadCount(child, DEFAULT_FAULT_THRESHOLD));
+    usleep(SETTLE_US);
+    ThreadLeakDetector::GetInstance().MainProcess();
+
+    std::string conclusion = FindConclusion();
+    ASSERT_FALSE(conclusion.empty());
+    std::string content = ThreadLeakUtil::ReadFileToString(conclusion, 8 * 1024 * 1024);
+    HIVIEW_LOGI("module test conclusion=%{public}s size=%{public}zu", conclusion.c_str(), content.size());
+
+    auto warnPos = content.find("WARNING SNAPSHOT");
+    auto faultPos = content.find("FAULT SNAPSHOT");
+    EXPECT_NE(warnPos, std::string::npos);
+    EXPECT_NE(faultPos, std::string::npos);
+    EXPECT_LT(warnPos, faultPos);
+    EXPECT_NE(content.find("process basic info"), std::string::npos);
+    EXPECT_NE(content.find("hidumper thread maintenance"), std::string::npos);
+    EXPECT_NE(content.find("per-thread run state"), std::string::npos);
+    EXPECT_NE(content.find("application call stack"), std::string::npos);
+
+    // Release the child and reap it.
+    (void)write(pipeFds[1], "x", 1);
+    close(pipeFds[1]);
+    int status = 0;
+    waitpid(child, &status, 0);
+}
+} // namespace HiviewDFX
+} // namespace OHOS
