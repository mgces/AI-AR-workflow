+}
+
+/**
+ * @tc.name: ThreadLeakUtilNaming001
+ * @tc.desc: name sanitizing and log path composition are well formed
+ * @tc.type: FUNC
+ */
+HWTEST_F(ThreadLeakDetectorUnitTest, ThreadLeakUtilNaming001, TestSize.Level1)
+{
