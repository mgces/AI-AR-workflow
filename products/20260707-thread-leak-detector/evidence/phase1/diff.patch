+#ifndef THREAD_LEAK_COMMON_H
+#define THREAD_LEAK_COMMON_H
+
+#include <cstdint>
+#include <string>
+
+namespace OHOS {
+namespace HiviewDFX {
+// Severity level derived from the current thread count of a process.
+enum class ThreadLeakLevel {
+    NORMAL = 0, // below the warning threshold
+    WARNING,    // reached the warning threshold, below the fault threshold
+    FAULT,      // reached the fault threshold
+};
+
+// Basic identity/state of a monitored process, filled in when a threshold is crossed.
+struct ProcessBasicInfo {
+    int32_t pid{-1};
+    int32_t uid{-1};
+    int32_t threadCount{0};
+    std::string processName;
+    std::string bundleName;
+    bool foreground{false};
+    bool foregroundKnown{false};
+};
+
+// Per-process runtime tracking used by the detector state machine.
+struct ProcessTrackInfo {
+    ThreadLeakLevel level{ThreadLeakLevel::NORMAL};
+    std::string warningTmpFile; // path of the most recent warning tmp log (empty if none)
+    bool faultReported{false};  // guards the once-per-episode fault report
+};
+
+constexpr uint32_t DEFAULT_WARNING_THRESHOLD = 2000;
+constexpr uint32_t DEFAULT_FAULT_THRESHOLD = 3000;
+constexpr uint64_t DEFAULT_POLL_INTERVAL_SEC = 30;
+
+const std::string THREAD_LEAK_ROOT_DIR = "/data/log/reliability/resource_leak/thread_leak";
+const std::string THREAD_LEAK_TMP_DIR = "/data/log/reliability/resource_leak/thread_leak/tmp";
+
+// Runtime-tunable system parameters (default to the fixed thresholds above). They let the
+// thresholds be lowered on a test device without rebuilding, and are read on every poll.
+const std::string PARAM_WARNING_THRESHOLD = "persist.hiviewdfx.threadleak.warn";
+const std::string PARAM_FAULT_THRESHOLD = "persist.hiviewdfx.threadleak.fault";
+// Optional diagnostic scoping: when > 0, only this pid is evaluated (0 = scan every process).
+const std::string PARAM_FOCUS_PID = "persist.hiviewdfx.threadleak.focuspid";
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // THREAD_LEAK_COMMON_H
