+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "thread_leak_detector.h"
+
+#include "app_mgr_client.h"
+#include "file_util.h"
+#include "hisysevent.h"
+#include "hiview_logger.h"
+#include "singleton.h"
+#include "thread_leak_collector.h"
+#include "thread_leak_config.h"
+#include "thread_leak_util.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+DEFINE_LOG_TAG("ThreadLeakDetector");
+
+namespace {
+constexpr size_t MAX_MERGE_SIZE = 1024 * 1024; // conclusion file cap
+// Markers emitted to hilog from the changed code path; used as runtime/e2e proof on a real device.
+const std::string MARKER_COLLECT = "THREAD_LEAK_COLLECT_TRIGGERED";
+const std::string MARKER_CONCLUSION = "THREAD_LEAK_CONCLUSION_GENERATED";
+} // namespace
+
+ThreadLeakDetector::ThreadLeakDetector() {}
+
+ThreadLeakDetector::~ThreadLeakDetector() {}
+
+ThreadLeakDecision ThreadLeakDetector::Decide(const ProcessTrackInfo &prev, ThreadLeakLevel newLevel)
+{
+    ThreadLeakDecision decision;
+    switch (newLevel) {
+        case ThreadLeakLevel::NORMAL:
+            // Back below the warning line: forget the process. A warning-only episode ends here
+            // with no conclusion file and no event, as required.
+            decision.dropTracking = true;
+            break;
+        case ThreadLeakLevel::WARNING:
+            // Collect and (re)write the warning tmp log every tick, discarding the previous one so
+            // that only the most recent warning survives to be merged if a fault follows.
+            decision.collect = true;
+            decision.refreshWarningLog = true;
+            break;
+        case ThreadLeakLevel::FAULT:
+            // Fault maintenance is collected once per fault episode ("触发一次"); once reported we
+            // stay quiet until the process recovers below the thresholds.
+            if (!(prev.level == ThreadLeakLevel::FAULT && prev.faultReported)) {
+                decision.collect = true;
+                decision.generateConclusion = true;
+                decision.reportEvent = true;
+            }
+            break;
+        default:
+            break;
+    }
+    return decision;
+}
+
+void ThreadLeakDetector::MainProcess()
+{
+    if (!ThreadLeakUtil::EnsureLogDirs()) {
+        HIVIEW_LOGE("thread leak log dirs unavailable, skip this tick");
+        return;
+    }
+    int32_t focusPid = ThreadLeakConfig::GetFocusPid();
+    std::vector<int32_t> pids = ThreadLeakUtil::GetAllProcessPids();
+    std::map<int32_t, bool> livePids;
+    for (int32_t pid : pids) {
+        livePids[pid] = true;
+        if (focusPid > 0 && pid != focusPid) {
+            continue;
+        }
+        int32_t threadCount = ThreadLeakUtil::GetThreadCount(pid);
+        if (threadCount < 0) {
+            continue;
+        }
+        ThreadLeakLevel level = ThreadLeakConfig::Classify(threadCount);
+        HandleProcess(pid, threadCount, level);
+    }
+    CleanupDeadProcesses(livePids);
+}
+
+void ThreadLeakDetector::HandleProcess(int32_t pid, int32_t threadCount, ThreadLeakLevel level)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    ProcessTrackInfo track = trackMap_.count(pid) ? trackMap_[pid] : ProcessTrackInfo();
+    ThreadLeakDecision decision = Decide(track, level);
+    if (decision.dropTracking) {
+        if (trackMap_.count(pid)) {
+            RemoveWarningTmp(track);
+            trackMap_.erase(pid);
+        }
+        return;
+    }
+    if (level == ThreadLeakLevel::WARNING) {
+        HandleWarning(pid, threadCount, track);
+    } else if (level == ThreadLeakLevel::FAULT && decision.collect) {
+        HandleFault(pid, threadCount, track);
+    }
+    track.level = level;
+    trackMap_[pid] = track;
+}
+
+void ThreadLeakDetector::HandleWarning(int32_t pid, int32_t threadCount, ProcessTrackInfo &track)
+{
+    HIVIEW_LOGW("%{public}s pid=%{public}d threads=%{public}d level=WARNING", MARKER_COLLECT.c_str(), pid, threadCount);
+    ProcessBasicInfo info = ThreadLeakCollector::CollectBasicInfo(pid);
+    info.threadCount = threadCount;
+    std::string report = ThreadLeakCollector::BuildMaintenanceReport(info, ThreadLeakLevel::WARNING);
+
+    std::string newTmp = ThreadLeakUtil::BuildTmpLogPath("warning", pid, NextSeq());
+    if (!FileUtil::SaveStringToFile(newTmp, report, true)) {
+        HIVIEW_LOGE("failed to write warning tmp log for pid=%{public}d", pid);
+        return;
+    }
+    // Discard the earlier warning log so only the most recent one is kept for merging.
+    if (!track.warningTmpFile.empty() && track.warningTmpFile != newTmp) {
+        (void)FileUtil::RemoveFile(track.warningTmpFile);
+    }
+    track.warningTmpFile = newTmp;
+    track.faultReported = false;
+}
+
+void ThreadLeakDetector::HandleFault(int32_t pid, int32_t threadCount, ProcessTrackInfo &track)
+{
+    HIVIEW_LOGE("%{public}s pid=%{public}d threads=%{public}d level=FAULT", MARKER_COLLECT.c_str(), pid, threadCount);
+    ProcessBasicInfo info = ThreadLeakCollector::CollectBasicInfo(pid);
+    info.threadCount = threadCount;
+    std::string faultReport = ThreadLeakCollector::BuildMaintenanceReport(info, ThreadLeakLevel::FAULT);
+
+    std::string faultTmp = ThreadLeakUtil::BuildTmpLogPath("fault", pid, NextSeq());
+    (void)FileUtil::SaveStringToFile(faultTmp, faultReport, true);
+
+    // Merge the (optional) latest warning log with the fault log into a single conclusion file.
+    // A direct-to-fault process simply has no warning section to prepend.
+    std::string merged;
+    if (!track.warningTmpFile.empty() && FileUtil::FileExists(track.warningTmpFile)) {
+        merged += "########## WARNING SNAPSHOT ##########\n";
+        merged += ThreadLeakUtil::ReadFileToString(track.warningTmpFile, MAX_MERGE_SIZE);
+        merged += "\n";
+    }
+    merged += "########## FAULT SNAPSHOT ##########\n";
+    merged += faultReport;
+
+    std::string conclusionPath = ThreadLeakUtil::BuildConclusionLogPath(info.processName, pid, NextSeq());
+    if (FileUtil::SaveStringToFile(conclusionPath, merged, true)) {
+        HIVIEW_LOGE("%{public}s pid=%{public}d path=%{public}s", MARKER_CONCLUSION.c_str(), pid,
+                    conclusionPath.c_str());
+    }
+
+    ReportThreadLeakEvent(info, conclusionPath);
+    KillBackgroundAppIfNeeded(info);
+
+    // The warning snapshot has been consumed into the conclusion; drop it.
+    RemoveWarningTmp(track);
+    track.faultReported = true;
+}
+
+void ThreadLeakDetector::ReportThreadLeakEvent(const ProcessBasicInfo &info, const std::string &conclusionPath)
+{
+    std::string foreground = info.foregroundKnown ? (info.foreground ? "Yes" : "No") : "";
+    std::string summary =
+        "process=" + info.processName + " bundle=" + (info.bundleName.empty() ? "unknown" : info.bundleName) +
+        " threads=" + std::to_string(info.threadCount) + " foreground=" + (foreground.empty() ? "unknown" : foreground);
+    // Report using the pre-existing RELIABILITY/THREAD_LEAK schema (MODULE/VERSION/PID/UID/
+    // THREAD_NUM/SUMMARY/FINGERPRINT/LOG_PATH/HAPPEN_TIME); the process/bundle/foreground detail is
+    // folded into SUMMARY, and the conclusion path goes to LOG_PATH.
+    int ret = HiSysEventWrite(HiSysEvent::Domain::RELIABILITY, "THREAD_LEAK", HiSysEvent::EventType::FAULT, "MODULE",
+                              info.processName, "PID", info.pid, "UID", info.uid, "THREAD_NUM",
+                              static_cast<int64_t>(info.threadCount), "SUMMARY", summary, "LOG_PATH", conclusionPath);
+    HIVIEW_LOGI("report THREAD_LEAK event pid=%{public}d ret=%{public}d", info.pid, ret);
+}
+
+void ThreadLeakDetector::KillBackgroundAppIfNeeded(const ProcessBasicInfo &info)
+{
+    if (!info.foregroundKnown || info.foreground || info.bundleName.empty()) {
+        return;
+    }
+    auto appClient = DelayedSingleton<AppExecFwk::AppMgrClient>::GetInstance();
+    if (appClient == nullptr) {
+        HIVIEW_LOGE("app mgr client null, cannot kill %{public}s", info.bundleName.c_str());
+        return;
+    }
+    auto ret = appClient->KillApplication(info.bundleName, false, 0, "THREAD_LEAK_FAULT"); // 0: appIndex
+    HIVIEW_LOGW("kill background app bundle=%{public}s pid=%{public}d ret=%{public}d", info.bundleName.c_str(),
+                info.pid, static_cast<int>(ret));
+}
+
+void ThreadLeakDetector::CleanupDeadProcesses(const std::map<int32_t, bool> &livePids)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (auto it = trackMap_.begin(); it != trackMap_.end();) {
+        if (livePids.count(it->first)) {
+            ++it;
+            continue;
+        }
+        RemoveWarningTmp(it->second);
+        it = trackMap_.erase(it);
+    }
+}
+
+void ThreadLeakDetector::RemoveWarningTmp(ProcessTrackInfo &track)
+{
+    if (!track.warningTmpFile.empty()) {
+        (void)FileUtil::RemoveFile(track.warningTmpFile);
+        track.warningTmpFile.clear();
+    }
+}
+
+uint64_t ThreadLeakDetector::NextSeq()
+{
+    return ++seq_;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
