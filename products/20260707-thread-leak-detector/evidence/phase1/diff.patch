+#include "thread_leak_util.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+DEFINE_LOG_TAG("ThreadLeakDetector");
+
+namespace {
+constexpr size_t MAX_DUMP_SIZE = 512 * 1024;            // cap collected sections to keep logs bounded
+constexpr mode_t HIDUMPER_TMP_MODE = S_IRUSR | S_IWUSR; // 0600
+
+std::string LevelToTag(ThreadLeakLevel level)
+{
+    switch (level) {
+        case ThreadLeakLevel::WARNING:
+            return "WARNING";
+        case ThreadLeakLevel::FAULT:
+            return "FAULT";
+        default:
+            return "NORMAL";
+    }
+}
+} // namespace
+
+ProcessBasicInfo ThreadLeakCollector::CollectBasicInfo(int32_t pid)
+{
+    ProcessBasicInfo info;
+    info.pid = pid;
+    info.threadCount = ThreadLeakUtil::GetThreadCount(pid);
+    info.processName = CommonUtils::GetProcFullNameByPid(pid);
+    if (info.processName.empty()) {
+        info.processName = CommonUtils::GetProcNameByPid(pid);
+    }
+    info.uid = CommonUtils::GetUidByPid(pid);
+
+    AppExecFwk::RunningProcessInfo procInfo;
+    auto appClient = DelayedSingleton<AppExecFwk::AppMgrClient>::GetInstance();
+    if (appClient != nullptr && appClient->GetRunningProcessInfoByPid(pid, procInfo) == ERR_OK) {
+        if (!procInfo.bundleNames.empty()) {
+            info.bundleName = procInfo.bundleNames.front();
+        }
+        info.foregroundKnown = true;
+        info.foreground = (procInfo.state_ == AppExecFwk::AppProcessState::APP_STATE_FOREGROUND ||
+                           procInfo.state_ == AppExecFwk::AppProcessState::APP_STATE_FOCUS);
+        if (info.uid < 0) {
+            info.uid = procInfo.uid_;
+        }
+    }
+    return info;
+}
+
+std::string ThreadLeakCollector::CollectHidumperThreadDump(int32_t pid)
+{
+    // Reach the hidumper SA directly through IDumpBroker (the light-weight proxy path), mirroring
+    // the equivalent of `hidumper -p <pid> --thread`.
+    auto sam = SystemAbilityManagerClient::GetInstance().GetSystemAbilityManager();
+    if (sam == nullptr) {
+        return "[hidumper] unavailable: no samgr\n";
+    }
+    // Prefer a blocking on-demand load so the SA is started if it is not resident; fall back to a
+    // plain check for the already-running case.
+    sptr<IRemoteObject> remote = sam->CheckSystemAbility(DFX_HI_DUMPER_SERVICE_ABILITY_ID);
+    if (remote == nullptr) {
+        constexpr int32_t loadSaTimeout = 4; // seconds
+        remote = sam->LoadSystemAbility(DFX_HI_DUMPER_SERVICE_ABILITY_ID, loadSaTimeout);
+    }
+    if (remote == nullptr) {
+        return "[hidumper] unavailable: sa not running\n";
+    }
+    sptr<IDumpBroker> client = iface_cast<IDumpBroker>(remote);
+    if (client == nullptr) {
+        return "[hidumper] unavailable: iface_cast failed\n";
+    }
+
+    std::string tmpPath = THREAD_LEAK_TMP_DIR + "/.hidumper_" + std::to_string(pid) + ".dump";
+    int fd = open(tmpPath.c_str(), O_CREAT | O_TRUNC | O_RDWR | O_CLOEXEC, HIDUMPER_TMP_MODE);
+    if (fd < 0) {
+        return "[hidumper] unavailable: cannot open temp fd\n";
+    }
+    // Build the args exactly as the hidumper CLI does: argv[0] is the program name (the SA parser
+    // skips it via getopt), followed by the options, and finally a trailing pid token that the
+    // service appends from the caller. Without that trailing token the service falls back to a bare
+    // "-p" process dump (ps -efT) instead of the "-p <pid> --thread" thread summary.
+    std::string pidStr = std::to_string(pid);
+    std::vector<std::u16string> args = {
+        Str8ToStr16(std::string("hidumper")),
+        Str8ToStr16(std::string("-p")),
+        Str8ToStr16(pidStr),
+        Str8ToStr16(std::string("--thread")),
+        Str8ToStr16(pidStr),
+    };
+    int32_t ret = client->Request(args, fd);
+    close(fd);
+
+    std::string result;
+    if (ret == 0) {
+        result = ThreadLeakUtil::ReadFileToString(tmpPath, MAX_DUMP_SIZE);
+    }
+    (void)FileUtil::RemoveFile(tmpPath);
+    if (result.empty()) {
+        return "[hidumper] unavailable or empty, ret=" + std::to_string(ret) + "\n";
+    }
+    return result;
+}
+
+std::string ThreadLeakCollector::CollectThreadRunStates(int32_t pid)
+{
+    std::ostringstream oss;
+    std::vector<ThreadRunState> runStates = ThreadLeakUtil::GetThreadRunStates(pid);
+
+    // Per-thread CPU run time via the unified_collection thread collector (may be unavailable).
+    std::map<int32_t, double> tidToCpuUsage;
+    std::map<int32_t, double> tidToCpuLoad;
+    auto collector = UCollectUtil::ThreadCpuCollector::Create(pid);
+    if (collector != nullptr) {
+        CollectResult<std::vector<ThreadCpuStatInfo>> result = collector->CollectThreadStatInfos(true);
+        if (result.retCode == UCollect::UcError::SUCCESS) {
+            for (const auto &item : result.data) {
+                tidToCpuUsage[item.tid] = item.cpuUsage;
+                tidToCpuLoad[item.tid] = item.cpuLoad;
+            }
+        }
+    }
+
+    oss << "thread_total=" << runStates.size() << "\n";
+    oss << "tid\tstate\tcpuUsage\tcpuLoad\tname\n";
+    for (const auto &st : runStates) {
+        double cpuUsage = tidToCpuUsage.count(st.tid) ? tidToCpuUsage[st.tid] : 0.0;
+        double cpuLoad = tidToCpuLoad.count(st.tid) ? tidToCpuLoad[st.tid] : 0.0;
+        oss << st.tid << "\t" << st.state << "\t" << cpuUsage << "\t" << cpuLoad << "\t" << st.name << "\n";
+    }
+    return oss.str();
+}
+
+std::string ThreadLeakCollector::CollectStackTrace(int32_t pid)
+{
+    // Use the text (human-readable) stack dump, not the JSON variant: DumpStacktrace writes a
+    // formatted per-thread call stack to the fd via DfxDumpCatcher.
+    std::string tmpPath = THREAD_LEAK_TMP_DIR + "/.stack_" + std::to_string(pid) + ".dump";
+    int fd = open(tmpPath.c_str(), O_CREAT | O_TRUNC | O_RDWR | O_CLOEXEC, HIDUMPER_TMP_MODE);
+    if (fd < 0) {
+        return "[stacktrace] unavailable: cannot open temp fd\n";
+    }
+    std::string terminalBinderStack;
+    LogCatcherUtils::TerminalBinderInfo binderInfo;
+    int ret = LogCatcherUtils::DumpStacktrace(fd, pid, terminalBinderStack, binderInfo);
+    close(fd);
+
+    std::string stack;
+    if (ret == 0) {
+        stack = ThreadLeakUtil::ReadFileToString(tmpPath, MAX_DUMP_SIZE);
+    }
+    (void)FileUtil::RemoveFile(tmpPath);
+    if (stack.empty()) {
+        return "[stacktrace] unavailable, ret=" + std::to_string(ret) + "\n";
+    }
+    return stack;
+}
+
+std::string ThreadLeakCollector::BuildMaintenanceReport(const ProcessBasicInfo &info, ThreadLeakLevel level)
+{
+    std::ostringstream oss;
+    oss << "==================== THREAD LEAK MAINTENANCE ====================\n";
+    oss << "level=" << LevelToTag(level) << "\n";
+    oss << "---- [1] process basic info ----\n";
+    oss << "processName=" << info.processName << "\n";
+    oss << "bundleName=" << (info.bundleName.empty() ? "unknown" : info.bundleName) << "\n";
+    oss << "pid=" << info.pid << "\n";
+    oss << "uid=" << info.uid << "\n";
+    oss << "threadCount=" << info.threadCount << "\n";
+    if (info.foregroundKnown) {
+        oss << "appState=" << (info.foreground ? "foreground" : "background") << "\n";
+    } else {
+        oss << "appState=unknown\n";
+    }
+    oss << "---- [2] hidumper thread maintenance (-p " << info.pid << " --thread) ----\n";
+    oss << CollectHidumperThreadDump(info.pid) << "\n";
+    oss << "---- [3] per-thread run state and cpu run time ----\n";
+    oss << CollectThreadRunStates(info.pid) << "\n";
+    oss << "---- [4] application call stack (LogCatcherUtils::DumpStacktrace) ----\n";
+    oss << CollectStackTrace(info.pid) << "\n";
+    oss << "================================================================\n";
+    return oss.str();
+}
+} // namespace HiviewDFX
+} // namespace OHOS
