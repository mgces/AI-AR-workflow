+#include "thread_leak_config.h"
+
+#include <cerrno>
+#include <cstdlib>
+#include <string>
+
+#include "parameter.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+constexpr int PARAM_VALUE_MAX_LEN = 32;
+
+uint32_t GetUintParameter(const std::string &key, uint32_t defValue)
+{
+    char value[PARAM_VALUE_MAX_LEN] = {0};
+    int ret = GetParameter(key.c_str(), std::to_string(defValue).c_str(), value, PARAM_VALUE_MAX_LEN);
+    if (ret <= 0) {
+        return defValue;
+    }
+    errno = 0;
+    char *endPtr = nullptr;
+    unsigned long parsed = std::strtoul(value, &endPtr, 10); // 10: decimal base
+    if (errno != 0 || endPtr == value || parsed == 0) {
+        return defValue;
+    }
+    return static_cast<uint32_t>(parsed);
+}
+} // namespace
+
+uint32_t ThreadLeakConfig::GetWarningThreshold()
+{
+    return GetUintParameter(PARAM_WARNING_THRESHOLD, DEFAULT_WARNING_THRESHOLD);
+}
+
+uint32_t ThreadLeakConfig::GetFaultThreshold()
+{
+    return GetUintParameter(PARAM_FAULT_THRESHOLD, DEFAULT_FAULT_THRESHOLD);
+}
+
+uint64_t ThreadLeakConfig::GetPollIntervalSec()
+{
+    return DEFAULT_POLL_INTERVAL_SEC;
+}
+
+int32_t ThreadLeakConfig::GetFocusPid()
+{
+    return static_cast<int32_t>(GetUintParameter(PARAM_FOCUS_PID, 0));
+}
+
+ThreadLeakLevel ThreadLeakConfig::Classify(int32_t threadCount)
+{
+    if (threadCount < 0) {
+        return ThreadLeakLevel::NORMAL;
+    }
+    uint32_t count = static_cast<uint32_t>(threadCount);
+    if (count >= GetFaultThreshold()) {
+        return ThreadLeakLevel::FAULT;
+    }
+    if (count >= GetWarningThreshold()) {
+        return ThreadLeakLevel::WARNING;
+    }
+    return ThreadLeakLevel::NORMAL;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
