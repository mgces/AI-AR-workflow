import("//base/hiviewdfx/hiview/hiview.gni")
import("//build/ohos.gni")
import("//build/test.gni")

module_output_path = "hiview/resource_monitor"

config("resource_monitor_test_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "../",
    "unittest/common",
    "$hiview_base/include",
  ]
}

resource_monitor_test_source = [
  "../resource_monitor_plugin.cpp",
  "../resmon_cpu_collector.cpp",
  "../resmon_mem_collector.cpp",
  "../resmon_io_collector.cpp",
  "../resmon_pwr_collector.cpp",
  "../resmon_net_collector.cpp",
  "../resmon_thr_collector.cpp",
  "../resmon_threshold.cpp",
  "../resmon_ring_buffer.cpp",
  "../resmon_landing.cpp",
  "../resmon_config.cpp",
  "../resmon_event_listener.cpp",
]

ohos_unittest("ResourceMonitorTest") {
  sources = [
    "unittest/common/resmon_config_test.cpp",
    "unittest/common/resmon_cpu_collector_test.cpp",
    "unittest/common/resmon_mem_collector_test.cpp",
    "unittest/common/resmon_io_collector_test.cpp",
    "unittest/common/resmon_pwr_collector_test.cpp",
    "unittest/common/resmon_net_collector_test.cpp",
    "unittest/common/resmon_thr_collector_test.cpp",
    "unittest/common/resmon_threshold_test.cpp",
    "unittest/common/resmon_ring_buffer_test.cpp",
    "unittest/common/resmon_landing_test.cpp",
    "unittest/common/resmon_event_listener_test.cpp",
    "unittest/common/resource_monitor_plugin_test.cpp",
  ]

  sources += resource_monitor_test_source

  configs = [ ":resource_monitor_test_config" ]

  cflags_cc = [
    "-Dprivate=public",
    "-Dprotected=public",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "cJSON:cjson",
    "ffrt:libffrt",
    "googletest:gmock",
    "googletest:gtest_main",
    "hilog:libhilog",
  ]

  deps = [
    "$hiview_base:hiviewbase_static_lib_for_tdd",
  ]

  module_out_path = module_output_path
}
