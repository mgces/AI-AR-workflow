+                                                "MemAvailable:      65536 kB\n");
+
+    ResmonEventListener listener;
+    listener.subscribes_.push_back(MakeSub("LOWMEM_EVENT", "lowmem"));
+    ResmonLanding landing(TEST_ROOT);
