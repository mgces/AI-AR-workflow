+namespace OHOS {
+namespace HiviewDFX {
+// CPU/load collector (FR-CPU-01/02/03). CPU counters are cumulative since boot, so
+// Collect() reports the delta against the previous tick; the first tick's delta is
+// measured from zero. Collect() runs only on the plugin work loop.
+class ResmonCpuCollector : public ResmonCollector {
+public:
+    ResmonCpuCollector() : ResmonCollector("cpu") {}
+    ~ResmonCpuCollector() override = default;
+
+    bool Collect(CpuSample &out, uint32_t topN);
+
+    // Stateless parse helpers, also used by the event snapshot path.
+    static bool ParseProcStat(const std::string &path, uint64_t &user, uint64_t &system, uint64_t &idle,
+                              uint64_t &iowait);
+    static bool ParseLoadAvg(const std::string &path, double &load1, double &load5, double &load15);
+
+private:
+    void CollectProcTop(uint32_t topN, std::vector<ProcCpuItem> &top);
+
+    uint64_t prevUserTicks_ = 0;
+    uint64_t prevSystemTicks_ = 0;
+    uint64_t prevIdleTicks_ = 0;
+    uint64_t prevIowaitTicks_ = 0;
+    std::map<int32_t, uint64_t> prevProcTicks_;
+};
