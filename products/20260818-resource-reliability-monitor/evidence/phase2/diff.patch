diff --git a/plugins/reliability/resource_monitor/resmon_mem_collector.cpp b/plugins/reliability/resource_monitor/resmon_mem_collector.cpp
new file mode 100644
index 00000000..85770513
--- /dev/null
+++ b/plugins/reliability/resource_monitor/resmon_mem_collector.cpp
@@ -0,0 +1,213 @@
+/*
+ * Copyright (c) 2026 Huawei Device Co., Ltd.
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "resmon_mem_collector.h"
+
+#include <algorithm>
+#include <dirent.h>
+#include <fstream>
+#include <sstream>
+#include <unistd.h>
+#include <vector>
+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+// /proc/<pid>/statm: fields are size resident shared ... (in pages); resident is index 1.
+constexpr int STATM_RSS_IDX = 1;
+
+bool IsPidDir(const std::string &name)
+{
+    if (name.empty()) {
+        return false;
+    }
+    for (char ch : name) {
+        if (ch < '0' || ch > '9') {
+            return false;
+        }
+    }
+    return true;
+}
+
+uint64_t PageSizeKb()
+{
+    long page = sysconf(_SC_PAGESIZE);
+    if (page <= 0) {
+        return 1;
+    }
+    return static_cast<uint64_t>(page / 1024); // 1024: bytes per kB
+}
+
+std::string ReadPidName(const std::string &procRoot, int32_t pid)
+{
+    std::ifstream ifs(procRoot + "/" + std::to_string(pid) + "/comm");
+    std::string name;
+    if (ifs.is_open()) {
+        std::getline(ifs, name);
+    }
+    return name;
+}
+
+bool ReadStatmRssKb(const std::string &procRoot, int32_t pid, uint64_t &rssKb)
+{
+    std::ifstream ifs(procRoot + "/" + std::to_string(pid) + "/statm");
+    if (!ifs.is_open()) {
+        return false;
+    }
+    uint64_t pages[STATM_RSS_IDX + 1] = {0};
+    for (int i = 0; i <= STATM_RSS_IDX; ++i) {
+        if (!(ifs >> pages[i])) {
+            return false;
+        }
+    }
+    rssKb = pages[STATM_RSS_IDX] * PageSizeKb();
+    return true;
+}
+
+bool ReadSmapsRollup(const std::string &procRoot, int32_t pid, uint64_t &rssKb, uint64_t &pssKb, uint64_t &ussKb)
+{
+    std::ifstream ifs(procRoot + "/" + std::to_string(pid) + "/smaps_rollup");
+    if (!ifs.is_open()) {
+        return false;
+    }
+    uint64_t privateClean = 0;
+    uint64_t privateDirty = 0;
+    std::string line;
+    while (std::getline(ifs, line)) {
+        std::istringstream iss(line);
+        std::string key;
+        uint64_t val = 0;
+        iss >> key >> val;
+        if (key == "Rss:") {
+            rssKb = val;
+        } else if (key == "Pss:") {
+            pssKb = val;
+        } else if (key == "Private_Clean:") {
+            privateClean = val;
+        } else if (key == "Private_Dirty:") {
+            privateDirty = val;
+        }
+    }
+    ussKb = privateClean + privateDirty;
+    return true;
+}
+} // namespace
+
+bool ResmonMemCollector::ParseMeminfo(const std::string &path, MemSample &out)
+{
+    out = MemSample();
+    std::ifstream ifs(path);
+    if (!ifs.is_open()) {
+        return false;
+    }
+    std::string line;
+    while (std::getline(ifs, line)) {
+        std::istringstream iss(line);
+        std::string key;
+        uint64_t val = 0;
+        iss >> key >> val;
+        if (key == "MemTotal:") {
+            out.memTotalKb = val;
+        } else if (key == "MemFree:") {
+            out.memFreeKb = val;
+        } else if (key == "MemAvailable:") {
+            out.memAvailableKb = val;
+        } else if (key == "Cached:") {
+            out.cachedKb = val;
+        } else if (key == "Buffers:") {
+            out.buffersKb = val;
+        } else if (key == "SwapTotal:") {
+            out.swapTotalKb = val;
+        } else if (key == "SwapFree:") {
+            out.swapFreeKb = val;
+        }
+    }
+    return true;
+}
+
+void ResmonMemCollector::CollectIon(MemSample &out)
+{
+    if (ionUsagePath_.empty()) {
+        return;
+    }
+    std::ifstream ifs(ionUsagePath_);
+    uint64_t val = 0;
+    if (ifs.is_open() && (ifs >> val)) {
+        out.ionPresent = true;
+        out.ionTotalKb = val;
+        return;
+    }
+    // ION interface absent on this kernel: skip the item and count it (FR-MEM-03 degrade).
+    RecordError();
+}
+
+void ResmonMemCollector::CollectProcTop(uint32_t topN, std::vector<ProcMemItem> &top)
+{
+    DIR *dirp = opendir(ProcRoot().c_str());
+    if (dirp == nullptr) {
+        RecordError();
+        return;
+    }
+    struct dirent *ent = nullptr;
+    std::vector<ProcMemItem> items;
+    while ((ent = readdir(dirp)) != nullptr) {
+        if (!IsPidDir(ent->d_name)) {
+            continue;
+        }
+        int32_t pid = std::stoi(ent->d_name);
+        ProcMemItem item;
+        item.pid = pid;
+        if (!ReadStatmRssKb(ProcRoot(), pid, item.rssKb)) {
+            continue;
+        }
+        items.push_back(item);
+    }
+    closedir(dirp);
+    std::sort(items.begin(), items.end(), [](const ProcMemItem &a, const ProcMemItem &b) {
+        if (a.rssKb != b.rssKb) {
+            return a.rssKb > b.rssKb;
+        }
+        return a.pid < b.pid;
+    });
+    size_t limit = std::min(static_cast<size_t>(topN), items.size());
+    for (size_t i = 0; i < limit; ++i) {
+        items[i].name = ReadPidName(ProcRoot(), items[i].pid);
+        uint64_t rssKb = 0;
+        uint64_t pssKb = 0;
+        uint64_t ussKb = 0;
+        if (ReadSmapsRollup(ProcRoot(), items[i].pid, rssKb, pssKb, ussKb)) {
+            items[i].pssKb = pssKb;
+            items[i].ussKb = ussKb;
+        }
+    }
+    top.assign(items.begin(), items.begin() + limit);
+}
+
+bool ResmonMemCollector::Collect(MemSample &out, uint32_t topN)
+{
+    if (!ParseMeminfo(ProcRoot() + "/meminfo", out)) {
+        RecordError();
+        return false;
+    }
+    CollectIon(out);
+    CollectProcTop(topN, out.procTop);
+    return true;
+}
+
+void ResmonMemCollector::SetIonUsagePath(const std::string &path)
+{
+    ionUsagePath_ = path;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
