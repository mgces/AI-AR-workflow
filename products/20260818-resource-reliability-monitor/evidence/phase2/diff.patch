+#include "resmon_event_listener.h"
+
+#include <set>
+
+#include "hiview_logger.h"
+#include "resmon_mem_collector.h"
+#include "resmon_thr_collector.h"
+#include "sys_event.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+DEFINE_LOG_TAG("Resmon");
+namespace {
+constexpr const char *EVENT_CATEGORY = "event";
+constexpr const char *PARAM_PID = "PID";
+constexpr const char *PARAM_PROCESS_NAME = "PROCESS_NAME";
+constexpr const char *SNAPSHOT_MARKER = "AR_RESMON_EVT_SNAPSHOT_OK";
+} // namespace
+
+bool ResmonEventListener::Init(HiviewContext *context, const std::vector<ResmonEventSubscribe> &subscribes,
+                               const Deps &deps)
+{
+    if (context == nullptr) {
+        return false;
+    }
+    subscribes_ = subscribes;
+    deps_ = deps;
+    std::set<std::string> eventNames;
+    for (const auto &sub : subscribes_) {
+        eventNames.insert(sub.name);
+    }
+    if (!eventNames.empty()) {
+        // Matching on the bus is by event name; domains stay documentation.
+        AddListenerInfo(Event::MessageType::SYS_EVENT, eventNames);
+    }
+    return true;
+}
+
+std::string ResmonEventListener::GetListenerName()
+{
+    return "ResmonEventListener";
+}
+
+const ResmonEventSubscribe *ResmonEventListener::Match(const std::string &eventName) const
+{
+    for (const auto &sub : subscribes_) {
+        if (sub.name == eventName) {
+            return &sub;
+        }
+    }
+    return nullptr;
+}
+
+std::string ResmonEventListener::BuildSnapshotText(const Event &msg, const ResmonEventSubscribe &sub) const
+{
+    std::string text = "event=" + msg.GetEventName() + " domain=" + msg.domain_ + " kind=" + sub.kind;
+    // The SysEvent accessors are not const-qualified even though reading the params is
+    // side-effect free; the framework dispatch passes the message as const Event&.
+    SysEvent &sysEvent = static_cast<SysEvent &>(const_cast<Event &>(msg));
+    if (sysEvent.IsParamExist(PARAM_PID)) {
+        text += " pid=" + std::to_string(sysEvent.GetEventIntValue(PARAM_PID));
+    }
+    if (sysEvent.IsParamExist(PARAM_PROCESS_NAME)) {
+        text += " process=" + sysEvent.GetEventValue(PARAM_PROCESS_NAME);
+    }
+    // Instant site: meminfo water + per-process memory TopN (stateless parse path).
+    if (deps_.memCollector != nullptr) {
+        MemSample mem;
+        if (deps_.memCollector->ParseMeminfo(deps_.memCollector->ProcRoot() + "/meminfo", mem)) {
+            text += "\n[mem] " + mem.ToText();
+        }
+    }
+    // D-state threads and state distribution at event time (stateless walk).
+    if (deps_.thrCollector != nullptr) {
+        ThrSample thr;
+        if (deps_.thrCollector->Collect(thr)) {
+            text += "\n[thr] " + thr.ToText();
+        }
+    }
+    // FR-STB-02: replay of the last periodic ticks before the event.
+    if (deps_.ring != nullptr) {
+        std::string contextText = deps_.ring->DrainAsText();
+        if (!contextText.empty()) {
+            text += "\n[pre-event]\n" + contextText;
+        }
+    }
+    return text;
+}
+
+void ResmonEventListener::OnUnorderedEvent(const Event &msg)
+{
+    if (msg.messageType_ != Event::MessageType::SYS_EVENT) {
+        return;
+    }
+    const ResmonEventSubscribe *sub = Match(msg.GetEventName());
+    if (sub == nullptr) {
+        return;
+    }
+    std::string text = BuildSnapshotText(msg, *sub);
+    bool landed = false;
+    if (deps_.landing != nullptr) {
+        landed = deps_.landing->Write(EVENT_CATEGORY, sub->suffix, text);
+    }
+    if (landed == true) {
+        HIVIEW_LOGI("%s event=%s", SNAPSHOT_MARKER, msg.GetEventName().c_str());
+    } else {
+        HIVIEW_LOGW("snapshot landing failed event=%s", msg.GetEventName().c_str());
+    }
+}
+} // namespace HiviewDFX
+} // namespace OHOS
