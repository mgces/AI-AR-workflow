+---
+Language:        Cpp
+# OHOS / hiview 4-space style. The hiview component ships no root .clang-format,
+# so this plugin carries its own to keep the new code clang-format clean and
+# consistent with the surrounding 4-space hiview sources.
+BasedOnStyle:    LLVM
+IndentWidth:     4
+AccessModifierOffset: -4
+TabWidth:        4
+UseTab:          Never
+ColumnLimit:     120
+PointerAlignment: Right
+DerivePointerAlignment: false
+SortIncludes:    false
+IncludeBlocks:   Preserve
+BreakBeforeBraces: Custom
+BraceWrapping:
+  AfterClass:      false
+  AfterControlStatement: false
+  AfterEnum:       false
+  AfterFunction:   true
+  AfterNamespace:  false
+  AfterStruct:     false
+  AfterUnion:      false
+  BeforeElse:      false
+  BeforeCatch:     false
+  IndentBraces:    false
+  SplitEmptyFunction: false
+  SplitEmptyRecord: false
+  SplitEmptyNamespace: false
+AlignAfterOpenBracket: Align
+AllowShortFunctionsOnASingleLine: Empty
+AllowShortIfStatementsOnASingleLine: Never
+AllowShortLoopsOnASingleLine: false
+AllowShortBlocksOnASingleLine: false
+SpaceBeforeParens: ControlStatements
+SpaceInEmptyParentheses: false
+SpacesInParentheses: false
+SpacesInSquareBrackets: false
+SpacesInAngles: false
+SpaceAfterCStyleCast: false
+SpaceAfterTemplateKeyword: false
+ConstructorInitializerIndentWidth: 4
+ContinuationIndentWidth: 4
+IndentCaseLabels: true
+NamespaceIndentation: None
+FixNamespaceComments: true
+Standard:        Cpp11
