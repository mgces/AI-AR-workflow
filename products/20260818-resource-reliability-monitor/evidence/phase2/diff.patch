+#include "resmon_ring_buffer.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+constexpr size_t MIN_CAPACITY = 1;
+} // namespace
+
+ResmonRingBuffer::ResmonRingBuffer(size_t capacity) : capacity_(capacity < MIN_CAPACITY ? MIN_CAPACITY : capacity) {}
+
+void ResmonRingBuffer::Push(const std::string &line)
+{
+    std::lock_guard<std::mutex> lk(mtx_);
+    if (buf_.size() >= capacity_) {
+        buf_.pop_front();
+    }
+    buf_.push_back(line);
+}
+
+std::string ResmonRingBuffer::DrainAsText() const
+{
+    std::lock_guard<std::mutex> lk(mtx_);
+    std::string out;
+    for (const auto &line : buf_) {
+        out += line;
+        out += "\n";
+    }
+    return out;
+}
+
+size_t ResmonRingBuffer::Size() const
+{
+    std::lock_guard<std::mutex> lk(mtx_);
+    return buf_.size();
+}
+} // namespace HiviewDFX
+} // namespace OHOS
