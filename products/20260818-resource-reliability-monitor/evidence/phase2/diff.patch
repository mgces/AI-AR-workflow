+
+namespace OHOS {
+namespace HiviewDFX {
+// Fixed-capacity ring buffer of the most recent periodic sample summaries (FR-STB-02).
+// Push() is called from the plugin work loop, DrainAsText() from the framework event
+// dispatch thread, so access is mutex-protected.
+class ResmonRingBuffer {
+public:
+    explicit ResmonRingBuffer(size_t capacity);
+    ~ResmonRingBuffer() = default;
+
+    void Push(const std::string &line);
+
+    // Newest-last concatenation of the buffered lines (pre-event context).
+    std::string DrainAsText() const;
+
+    size_t Size() const;
+
+private:
+    mutable std::mutex mtx_;
+    std::deque<std::string> buf_;
+    size_t capacity_;
