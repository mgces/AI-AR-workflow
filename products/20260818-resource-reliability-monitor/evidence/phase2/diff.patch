+#ifndef HIVIEW_PLUGINS_RELIABILITY_RESMON_CONFIG_H
+#define HIVIEW_PLUGINS_RELIABILITY_RESMON_CONFIG_H
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "resmon_threshold.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+// One event-bus subscription entry (FR-TRG-02). kind classifies the snapshot content:
+// OOM/FREEZE/GENERIC; suffix names the landed snapshot file. Matching on the
+// hiview event bus is by event name; domain is documentation for operators.
+struct ResmonEventSubscribe {
+    std::string domain;
+    std::string name;
+    std::string kind;
+    std::string suffix;
+};
+
+// Plugin configuration (FR-CFG-01/02/03). Every field has a working default, so a
+// missing or malformed file degrades to defaults instead of failing the plugin.
+struct ResmonConfig {
+    uint32_t periodSec = 5;
+    uint32_t topN = 10;
+    uint32_t quotaFiles = 10;
+    uint64_t retentionSec = 86400;
+    uint64_t ringCapacity = 12;
+    std::string procRoot = "/proc";
+    std::string sysRoot = "/sys";
+    std::string ionUsagePath; // empty: ION item disabled entirely
+    std::vector<std::string> mountPoints{"/", "/data"};
+    ThresholdConfig thresholds;
+    std::vector<ResmonEventSubscribe> events;
+
+    static ResmonConfig LoadDefault();
+    // Missing/bad file returns the defaults (FR-CFG-03); periodSec clamps to minimum.
+    static ResmonConfig Load(const std::string &path);
+};
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // HIVIEW_PLUGINS_RELIABILITY_RESMON_CONFIG_H
diff --git a/plugins/reliability/resource_monitor/resmon_cpu_collector.cpp b/plugins/reliability/resource_monitor/resmon_cpu_collector.cpp
new file mode 100644
index 00000000..b94b2e06
--- /dev/null
+++ b/plugins/reliability/resource_monitor/resmon_cpu_collector.cpp
@@ -0,0 +1,190 @@
+/*
+ * Copyright (c) 2026 Huawei Device Co., Ltd.
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "resmon_cpu_collector.h"
+
+#include <algorithm>
+#include <dirent.h>
+#include <fstream>
+#include <sstream>
+#include <vector>
+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+// /proc/<pid>/stat: tokens after "comm)" start at field 3 (state). utime is field 14,
+// stime field 15, i.e. token index 11/12 counting from the state token.
+constexpr int STAT_STATE_IDX = 0;
+constexpr int STAT_UTIME_IDX = 11;
+constexpr int STAT_STIME_IDX = 12;
+
+bool SplitPidStat(const std::string &line, std::string &comm, std::vector<std::string> &rest)
+{
+    size_t close = line.rfind(')');
+    if (close == std::string::npos || close + 1 >= line.size()) {
+        return false;
+    }
+    size_t open = line.find('(');
+    if (open == std::string::npos || open + 1 > close) {
+        return false;
+    }
+    comm = line.substr(open + 1, close - open - 1);
+    std::istringstream iss(line.substr(close + 1));
+    std::string tok;
+    while (iss >> tok) {
+        rest.push_back(tok);
+    }
+    return rest.size() > STAT_STIME_IDX;
+}
+
+bool IsPidDir(const std::string &name)
+{
+    if (name.empty()) {
+        return false;
+    }
+    for (char ch : name) {
+        if (ch < '0' || ch > '9') {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool ReadPidStat(const std::string &procRoot, int32_t pid, std::string &comm, char &state, uint64_t &ticks)
+{
+    std::ifstream ifs(procRoot + "/" + std::to_string(pid) + "/stat");
+    if (!ifs.is_open()) {
+        return false;
+    }
+    std::string line;
+    if (!std::getline(ifs, line)) {
+        return false;
+    }
+    std::vector<std::string> rest;
+    if (!SplitPidStat(line, comm, rest)) {
+        return false;
+    }
+    state = rest[STAT_STATE_IDX][0];
+    std::istringstream utimeIss(rest[STAT_UTIME_IDX]);
+    std::istringstream stimeIss(rest[STAT_STIME_IDX]);
+    uint64_t utime = 0;
+    uint64_t stime = 0;
+    if (!(utimeIss >> utime) || !(stimeIss >> stime)) {
+        return false;
+    }
+    ticks = utime + stime;
+    return true;
+}
+} // namespace
+
+bool ResmonCpuCollector::ParseProcStat(const std::string &path, uint64_t &user, uint64_t &system, uint64_t &idle,
+                                       uint64_t &iowait)
+{
+    std::ifstream ifs(path);
+    if (!ifs.is_open()) {
+        return false;
+    }
+    std::string line;
+    if (!std::getline(ifs, line)) {
+        return false;
+    }
+    std::istringstream iss(line);
+    std::string label;
+    uint64_t nice = 0;
+    iss >> label >> user >> nice >> system >> idle >> iowait;
+    return !iss.fail() && (label == "cpu");
+}
+
+bool ResmonCpuCollector::ParseLoadAvg(const std::string &path, double &load1, double &load5, double &load15)
+{
+    std::ifstream ifs(path);
+    if (!ifs.is_open()) {
+        return false;
+    }
+    ifs >> load1 >> load5 >> load15;
+    return !ifs.fail();
+}
+
+bool ResmonCpuCollector::Collect(CpuSample &out, uint32_t topN)
+{
+    out = CpuSample();
+    uint64_t user = 0;
+    uint64_t system = 0;
+    uint64_t idle = 0;
+    uint64_t iowait = 0;
+    if (!ParseProcStat(ProcRoot() + "/stat", user, system, idle, iowait)) {
+        RecordError();
+        return false;
+    }
+    // Per-tick delta against the previous cumulative counter; a counter reset (smaller
+    // than the previous value) clamps to zero instead of underflowing.
+    out.userTicks = (user >= prevUserTicks_) ? user - prevUserTicks_ : 0;
+    out.systemTicks = (system >= prevSystemTicks_) ? system - prevSystemTicks_ : 0;
+    out.idleTicks = (idle >= prevIdleTicks_) ? idle - prevIdleTicks_ : 0;
+    out.iowaitTicks = (iowait >= prevIowaitTicks_) ? iowait - prevIowaitTicks_ : 0;
+    prevUserTicks_ = user;
+    prevSystemTicks_ = system;
+    prevIdleTicks_ = idle;
+    prevIowaitTicks_ = iowait;
+    if (!ParseLoadAvg(ProcRoot() + "/loadavg", out.load1, out.load5, out.load15)) {
+        RecordError();
+    }
+    CollectProcTop(topN, out.procTop);
+    return true;
+}
+
+void ResmonCpuCollector::CollectProcTop(uint32_t topN, std::vector<ProcCpuItem> &top)
+{
+    DIR *dirp = opendir(ProcRoot().c_str());
+    if (dirp == nullptr) {
+        RecordError();
+        return;
+    }
+    struct dirent *ent = nullptr;
+    std::vector<ProcCpuItem> items;
+    while ((ent = readdir(dirp)) != nullptr) {
+        if (!IsPidDir(ent->d_name)) {
+            continue;
+        }
+        int32_t pid = std::stoi(ent->d_name);
+        std::string comm;
+        char state = '\0';
+        uint64_t ticks = 0;
+        if (!ReadPidStat(ProcRoot(), pid, comm, state, ticks)) {
+            continue;
+        }
+        uint64_t prev = 0;
+        auto it = prevProcTicks_.find(pid);
+        if (it != prevProcTicks_.end()) {
+            prev = it->second;
+        }
+        ProcCpuItem item;
+        item.pid = pid;
+        item.name = comm;
+        item.cpuTicks = (ticks >= prev) ? ticks - prev : 0;
+        prevProcTicks_[pid] = ticks;
+        items.push_back(item);
+    }
+    closedir(dirp);
+    std::sort(items.begin(), items.end(), [](const ProcCpuItem &a, const ProcCpuItem &b) {
+        if (a.cpuTicks != b.cpuTicks) {
+            return a.cpuTicks > b.cpuTicks;
+        }
+        return a.pid < b.pid;
+    });
+    size_t limit = std::min(static_cast<size_t>(topN), items.size());
+    top.assign(items.begin(), items.begin() + limit);
+}
+} // namespace HiviewDFX
+} // namespace OHOS
