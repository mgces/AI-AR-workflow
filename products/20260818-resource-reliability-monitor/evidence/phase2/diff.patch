+#define HIVIEW_PLUGINS_RELIABILITY_RESMON_THR_COLLECTOR_H
+
+#include "resmon_collector.h"
+#include "resmon_types.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+// Thread-state collector (FR-THR-01). Walks /proc/<pid>/task/<tid>/stat once per tick,
+// counts scheduler states (R/D/S/T) and lists D-state threads. Instantaneous, stateless;
+// also used by the event snapshot path. Threads that vanish mid-scan are skipped.
+class ResmonThrCollector : public ResmonCollector {
+public:
+    ResmonThrCollector() : ResmonCollector("thr") {}
+    ~ResmonThrCollector() override = default;
+
+    bool Collect(ThrSample &out);
+
+    // Folds one process's threads (/proc/<pid>/task) into the sample; called per
+    // process by Collect() to keep each function short (G.FUD.05).
+    void CollectProcessThreads(const std::string &taskDir, int32_t pid, ThrSample &out);
+
+    // Folds one parsed thread state into the counters and D-state list.
+    void FoldThreadState(int32_t pid, int32_t tid, const std::string &comm, char state, ThrSample &out);
+
+    static bool ParseThreadStat(const std::string &path, std::string &comm, char &state);
+};
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // HIVIEW_PLUGINS_RELIABILITY_RESMON_THR_COLLECTOR_H
