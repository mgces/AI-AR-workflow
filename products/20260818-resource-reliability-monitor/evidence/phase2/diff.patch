+ * limitations under the License.
+ */
+#include "resource_monitor_plugin.h"
+
+#include <chrono>
+#include <string>
+#include <sys/stat.h>
+#include <unordered_set>
+
+#include "hiview_logger.h"
+#include "plugin_factory.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+REGISTER(ResourceMonitorPlugin);
+DEFINE_LOG_TAG("Resmon");
+namespace {
+constexpr const char *CONFIG_PATH = "/system/etc/hiview/resmon_config.json";
+// Writable cloud-config location (CLOUD_CFG_PATH of the param-update framework). Dev boards
+// have no signed param package, so OnConfigUpdate is certificate-blocked and never fires;
+// PollCloudConfig() watches this path as the hot-update fallback (FR-CFG-02).
+constexpr const char *CLOUD_CFG_PATH = "/data/system/hiview/resmon_config.json";
+constexpr const char *LANDING_ROOT = "/data/log/reliability/resmon";
+constexpr const char *CATEGORY_CPU = "cpu";
+constexpr const char *CATEGORY_MEM = "mem";
+constexpr const char *CATEGORY_IO = "io";
+constexpr const char *CATEGORY_PWR = "pwr";
+constexpr const char *CATEGORY_NET = "net";
+constexpr const char *CATEGORY_THR = "thr";
+constexpr const char *CATEGORY_EVENT = "event";
+constexpr const char *SUFFIX_ENHANCED = "enhanced";
+constexpr const char *SUFFIX_TRIP = "trip";
+constexpr const char *MARKER_PERIODIC = "AR_RESMON_PERIODIC_OK";
+constexpr const char *MARKER_THRESH_CPU = "AR_RESMON_THRESH_CPU_OK";
+constexpr const char *MARKER_THRESH_MEM = "AR_RESMON_THRESH_MEM_OK";
+constexpr const char *MARKER_TEMP_TRIP = "AR_RESMON_TEMP_TRIP_OK";
+constexpr const char *MARKER_ROLLING = "AR_RESMON_ROLLING_OK";
+constexpr const char *MARKER_HOTCFG = "AR_RESMON_HOTCFG_OK";
+
+const std::vector<std::string> &AllCategories()
+{
+    static const std::vector<std::string> categories = {CATEGORY_CPU, CATEGORY_MEM, CATEGORY_IO,   CATEGORY_PWR,
+                                                        CATEGORY_NET, CATEGORY_THR, CATEGORY_EVENT};
+    return categories;
+}
+} // namespace
+
+bool ResourceMonitorPlugin::ReadyToLoad()
+{
+    return true;
+}
+
+void ResourceMonitorPlugin::OnLoad()
+{
+    SetName("ResourceMonitorPlugin");
+    SetVersion("1.0");
+    auto context = GetHiviewContext();
+    if (context == nullptr) {
+        HIVIEW_LOGE("GetHiviewContext failed");
+        return;
+    }
+    config_ = ResmonConfig::Load(CONFIG_PATH);
+    workLoop_ = context->GetSharedWorkLoop();
+    if (workLoop_ == nullptr) {
+        HIVIEW_LOGE("GetSharedWorkLoop failed");
+        return;
+    }
+    cpuCollector_ = std::make_unique<ResmonCpuCollector>();
+    memCollector_ = std::make_unique<ResmonMemCollector>();
+    ioCollector_ = std::make_unique<ResmonIoCollector>();
+    pwrCollector_ = std::make_unique<ResmonPwrCollector>();
+    netCollector_ = std::make_unique<ResmonNetCollector>();
+    thrCollector_ = std::make_unique<ResmonThrCollector>();
+    threshold_ = std::make_unique<ResmonThreshold>(config_.thresholds);
+    landing_ = std::make_unique<ResmonLanding>(LANDING_ROOT);
+    landing_->EnsureCategoryDirs(AllCategories());
+    ring_ = std::make_unique<ResmonRingBuffer>(config_.ringCapacity);
+    if (config_.thresholds.eventEnabled) {
+        listener_ = std::make_shared<ResmonEventListener>();
+        ResmonEventListener::Deps deps;
+        deps.landing = landing_.get();
+        deps.ring = ring_.get();
+        deps.memCollector = memCollector_.get();
+        deps.thrCollector = thrCollector_.get();
+        if (listener_->Init(context, config_.events, deps)) {
+            context->RegisterUnorderedEventListener(listener_);
+            // Event-trigger path: SysEventDispatcher forwards matching sys events to
+            // OnEventListeningCallback (real sys events do not feed the unordered listener
+            // path in this build). Pre-filter by name so the callback only sees subscribed
+            // events. RegisterUnorderedEventListener is kept for the direct unit-test path.
+            std::unordered_set<std::string> eventNames;
+            for (const auto &sub : config_.events) {
+                eventNames.insert(sub.name);
+            }
+            AddDispatchInfo({}, eventNames, {}, {});
+        }
+    }
+    RebuildTimer();
+    HIVIEW_LOGI("ResourceMonitorPlugin loaded period=%us events=%zu", config_.periodSec, config_.events.size());
+}
+
+void ResourceMonitorPlugin::OnUnload()
+{
+    if (workLoop_ != nullptr && timerSeq_ != 0) {
+        workLoop_->RemoveEvent(timerSeq_);
+    }
+    timerSeq_ = 0;
+    HIVIEW_LOGI("ResourceMonitorPlugin unloaded");
+}
+
+void ResourceMonitorPlugin::RebuildTimer()
+{
+    if (workLoop_ == nullptr) {
+        return;
+    }
+    if (timerSeq_ != 0) {
+        workLoop_->RemoveEvent(timerSeq_);
+        timerSeq_ = 0;
+    }
+    timerSeq_ = workLoop_->AddTimerEvent(
+        nullptr, nullptr, [this] { OnTimerTick(); }, config_.periodSec, true);
+}
+
+void ResourceMonitorPlugin::OnConfigUpdate(const std::string &localCfgPath, const std::string &cloudCfgPath)
+{
+    (void)cloudCfgPath;
+    // Framework param-update thread: only queue the reload request (see header note).
+    if (localCfgPath.empty()) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lk(cfgPathMutex_);
+        pendingCfgPath_ = localCfgPath;
+    }
+    configDirty_.store(true);
+}
+
+void ResourceMonitorPlugin::OnEventListeningCallback(const Event &msg)
+{
+    // SysEventDispatcher forwards matching sys events here (see header note). The listener
+    // filters by subscribed event name and only lands snapshots for its configured events.
+    if (listener_ == nullptr || msg.messageType_ != Event::MessageType::SYS_EVENT) {
+        return;
+    }
+    listener_->OnUnorderedEvent(msg);
+}
+
+void ResourceMonitorPlugin::PollCloudConfig()
+{
+    // Hot-update fallback for boards where the framework param-update dispatch is
+    // certificate-blocked: queue a reload when the writable cloud config file changes,
+    // then let the tick top apply it (FR-CFG-02). No cloud config -> nothing to watch.
+    struct stat st;
+    if (stat(CLOUD_CFG_PATH, &st) != 0 || !S_ISREG(st.st_mode)) {
+        return;
+    }
+    uint64_t mtime =
+        static_cast<uint64_t>(st.st_mtim.tv_sec) * 1000ULL + static_cast<uint64_t>(st.st_mtim.tv_nsec) / 1000000ULL;
+    uint64_t size = static_cast<uint64_t>(st.st_size);
+    if (mtime == cloudCfgMtime_ && size == cloudCfgSize_) {
+        return;
+    }
+    cloudCfgMtime_ = mtime;
+    cloudCfgSize_ = size;
+    {
+        std::lock_guard<std::mutex> lk(cfgPathMutex_);
+        pendingCfgPath_ = CLOUD_CFG_PATH;
+    }
+    configDirty_.store(true);
+}
+
+void ResourceMonitorPlugin::ApplyConfig(const ResmonConfig &cfg)
+{
+    config_ = cfg;
+    threshold_ = std::make_unique<ResmonThreshold>(config_.thresholds);
+    for (auto *collector :
+         std::vector<ResmonCollector *>{cpuCollector_.get(), memCollector_.get(), ioCollector_.get(),
+                                        pwrCollector_.get(), netCollector_.get(), thrCollector_.get()}) {
+        if (collector == nullptr) {
+            continue;
+        }
+        collector->SetProcRoot(config_.procRoot);
+        collector->SetSysRoot(config_.sysRoot);
+    }
+    if (memCollector_ != nullptr) {
+        memCollector_->SetIonUsagePath(config_.ionUsagePath);
+    }
+    if (ioCollector_ != nullptr) {
+        ioCollector_->SetMountPoints(config_.mountPoints);
+    }
+    RebuildTimer();
+    HIVIEW_LOGI("%s period=%u", MARKER_HOTCFG, config_.periodSec);
+}
+
+uint64_t ResourceMonitorPlugin::NowMs() const
+{
+    auto dur = std::chrono::steady_clock::now().time_since_epoch();
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(dur).count());
+}
+
+std::string ResourceMonitorPlugin::RingSummary(const CpuSample &cpu, const MemSample &mem, const PwrSample &pwr) const
+{
+    uint64_t used = cpu.userTicks + cpu.systemTicks + cpu.iowaitTicks;
+    uint64_t total = used + cpu.idleTicks;
+    std::string summary = "cpu=" + std::to_string(used) + "/" + std::to_string(total);
+    summary += " memAvail=" + std::to_string(mem.memAvailableKb) + "kB";
+    for (const auto &zone : pwr.zones) {
+        summary += " " + zone.zone + "=" + std::to_string(zone.tempC) + "C";
+    }
+    return summary;
+}
+
+void ResourceMonitorPlugin::CollectAndLand(ResmonSamples &samples)
+{
+    // Each category collects independently; a failing item skips only its own landing
+    // (FR-ERR-01 isolation) and counts into that collector's error counter.
+    if (cpuCollector_ != nullptr && cpuCollector_->Collect(samples.cpu, config_.topN)) {
+        landing_->Write(CATEGORY_CPU, "", samples.cpu.ToText());
+    }
+    if (memCollector_ != nullptr && memCollector_->Collect(samples.mem, config_.topN)) {
+        landing_->Write(CATEGORY_MEM, "", samples.mem.ToText());
+    }
+    if (ioCollector_ != nullptr && ioCollector_->Collect(samples.io)) {
+        landing_->Write(CATEGORY_IO, "", samples.io.ToText());
+    }
+    if (pwrCollector_ != nullptr && pwrCollector_->Collect(samples.pwr)) {
+        landing_->Write(CATEGORY_PWR, "", samples.pwr.ToText());
+    }
+    if (netCollector_ != nullptr && netCollector_->Collect(samples.net)) {
+        landing_->Write(CATEGORY_NET, "", samples.net.ToText());
+    }
+    if (thrCollector_ != nullptr && thrCollector_->Collect(samples.thr)) {
+        landing_->Write(CATEGORY_THR, "", samples.thr.ToText());
+    }
+}
+
+void ResourceMonitorPlugin::HandleThreshold(ThresholdReason reason, const CpuSample &cpu, const MemSample &mem,
+                                            const PwrSample &pwr)
+{
+    switch (reason) {
+        case ThresholdReason::CPU_OVER:
+            landing_->Write(CATEGORY_CPU, SUFFIX_ENHANCED, cpu.ToText());
+            HIVIEW_LOGI("%s", MARKER_THRESH_CPU);
+            break;
+        case ThresholdReason::MEM_LOW:
+            landing_->Write(CATEGORY_MEM, SUFFIX_ENHANCED, mem.ToText());
+            HIVIEW_LOGI("%s", MARKER_THRESH_MEM);
+            break;
+        case ThresholdReason::TEMP_OVER:
+            landing_->Write(CATEGORY_PWR, SUFFIX_TRIP, pwr.ToText());
+            HIVIEW_LOGI("%s", MARKER_TEMP_TRIP);
+            break;
+        case ThresholdReason::NONE:
+            break;
+    }
+}
+
+void ResourceMonitorPlugin::OnTimerTick()
+{
+    PollCloudConfig();
+    if (configDirty_.exchange(false)) {
+        std::string path;
+        {
+            std::lock_guard<std::mutex> lk(cfgPathMutex_);
+            path = pendingCfgPath_;
+        }
+        ApplyConfig(ResmonConfig::Load(path));
+    }
+    if (!config_.thresholds.periodicEnabled) {
+        return; // FR-TRG-04: periodic mechanism independently switched off
+    }
+    if (landing_ == nullptr || threshold_ == nullptr || ring_ == nullptr) {
+        return;
+    }
+    ResmonSamples samples;
+    CollectAndLand(samples);
+    HIVIEW_LOGI("%s", MARKER_PERIODIC);
+
+    uint32_t removed = 0;
+    for (const auto &category : AllCategories()) {
+        removed += landing_->RollingCleanup(category, config_.quotaFiles, config_.retentionSec);
+    }
+    if (removed > 0) {
+        HIVIEW_LOGI("%s removed=%u", MARKER_ROLLING, removed);
+    }
+    ring_->Push(RingSummary(samples.cpu, samples.mem, samples.pwr));
+    HandleThreshold(threshold_->Evaluate(samples.cpu, samples.mem, samples.pwr, NowMs()), samples.cpu, samples.mem,
+                    samples.pwr);
+}
+
+void ResourceMonitorPlugin::Dump(int fd, const std::vector<std::string> &cmds)
+{
+    (void)fd;
+    (void)cmds;
+    uint64_t cpuErr = (cpuCollector_ != nullptr) ? cpuCollector_->ErrorCount() : 0;
+    uint64_t memErr = (memCollector_ != nullptr) ? memCollector_->ErrorCount() : 0;
+    uint64_t ioErr = (ioCollector_ != nullptr) ? ioCollector_->ErrorCount() : 0;
+    uint64_t pwrErr = (pwrCollector_ != nullptr) ? pwrCollector_->ErrorCount() : 0;
+    uint64_t netErr = (netCollector_ != nullptr) ? netCollector_->ErrorCount() : 0;
+    uint64_t thrErr = (thrCollector_ != nullptr) ? thrCollector_->ErrorCount() : 0;
+    HIVIEW_LOGI("period=%u topN=%u errors cpu:%llu mem:%llu io:%llu pwr:%llu net:%llu thr:%llu", config_.periodSec,
+                config_.topN, static_cast<unsigned long long>(cpuErr), static_cast<unsigned long long>(memErr),
+                static_cast<unsigned long long>(ioErr), static_cast<unsigned long long>(pwrErr),
+                static_cast<unsigned long long>(netErr), static_cast<unsigned long long>(thrErr));
+}
+} // namespace HiviewDFX
+} // namespace OHOS
