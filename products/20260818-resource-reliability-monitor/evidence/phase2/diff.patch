+
+#include "resmon_collector.h"
+#include "resmon_types.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+// Disk IO / storage watermark collector (FR-IO-01/02). diskstats counters are cumulative,
+// so Collect() reports per-tick deltas against the previous sample; partition water is
+// instantaneous (statfs). Collect() runs only on the plugin work loop.
+class ResmonIoCollector : public ResmonCollector {
