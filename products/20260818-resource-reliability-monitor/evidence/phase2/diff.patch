+ * limitations under the License.
+ */
+#ifndef HIVIEW_PLUGINS_RELIABILITY_RESMON_THRESHOLD_H
+#define HIVIEW_PLUGINS_RELIABILITY_RESMON_THRESHOLD_H
+
+#include <cstdint>
+#include <map>
+
+#include "resmon_types.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+enum class ThresholdReason {
+    NONE,
+    CPU_OVER, // FR-TRG-03: CPU usage above cpuThresholdPct
+    MEM_LOW,  // FR-TRG-03: MemAvailable below memAvailThresholdMB
+    TEMP_OVER // FR-PWR-04: zone temp above the configured threshold or its trip point
+};
+
+// Threshold trigger configuration (FR-TRG-03/04/05). The three trigger mechanisms
+// (periodic/event/threshold) carry independent switches; tempThresholdC <= 0 means
+// "judge against the zone's own trip point" instead of a fixed threshold.
+struct ThresholdConfig {
+    bool periodicEnabled = true;
+    bool eventEnabled = true;
+    bool thresholdEnabled = true;
+    uint32_t cpuThresholdPct = 90;
+    uint64_t memAvailThresholdMB = 200;
+    int32_t tempThresholdC = 0;
+    uint32_t debounce = 2;
+    uint32_t minIntervalSec = 30;
+};
+
+// Threshold evaluation with debounce (M consecutive over-limit ticks before triggering,
+// FR-TRG-05) and a minimum interval between triggers. Evaluate() runs only on the plugin
+// work loop.
+class ResmonThreshold {
+public:
+    explicit ResmonThreshold(const ThresholdConfig &cfg);
+    ~ResmonThreshold() = default;
+
+    ThresholdReason Evaluate(const CpuSample &cpu, const MemSample &mem, const PwrSample &pwr, uint64_t nowMs);
+
+    void Reset();
+
+private:
+    ThresholdReason CheckOver(const CpuSample &cpu, const MemSample &mem, const PwrSample &pwr) const;
+    void UpdateDebounce(ThresholdReason candidate);
+    bool IntervalPassed(uint64_t nowMs) const;
+
+    ThresholdConfig cfg_;
+    std::map<ThresholdReason, uint32_t> consecutive_;
+    uint64_t lastTriggerMs_ = 0;
+};
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // HIVIEW_PLUGINS_RELIABILITY_RESMON_THRESHOLD_H
