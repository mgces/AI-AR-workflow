+
+/**
+ * @tc.name: ResmonEventListenerOomSnapshot
+ * @tc.desc: an OOM-class event snapshot carries the memory watermark
+ * @tc.type: FUNC
+ */
+TEST_F(ResmonEventListenerTest, OomSnapshotContent)
