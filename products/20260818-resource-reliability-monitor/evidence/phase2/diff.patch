+#ifndef HIVIEW_PLUGINS_RELIABILITY_RESMON_LANDING_H
+#define HIVIEW_PLUGINS_RELIABILITY_RESMON_LANDING_H
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace OHOS {
+namespace HiviewDFX {
+// Text landing under /data/log/reliability/resmon/<category>/ (FR-DSK-01/02/03).
+// File name: resmon_<category>[_<suffix>]_<YYYYMMDDHHMMSS>.log, opened in append mode so
+// writes within the same second accumulate instead of overwriting each other. The same
+// file is never written from two threads: periodic writes come from the plugin work loop,
+// snapshot writes from the event dispatch thread, and the two never share a category
+// ("event" belongs to the snapshot path only).
+class ResmonLanding {
+public:
+    explicit ResmonLanding(const std::string &rootDir);
+    ~ResmonLanding() = default;
+
+    // suffix may be empty (periodic landing); returns false when the file cannot be opened.
+    bool Write(const std::string &category, const std::string &suffix, const std::string &text);
+
+    // Dual-dimension rolling cleanup (FR-DSK-04): delete files older than maxAgeSec and
+    // keep only the newest maxFiles per category. Returns the number of removed files.
+    uint32_t RollingCleanup(const std::string &category, uint32_t maxFiles, uint64_t maxAgeSec);
+
+    // Create all category directories up front so the full landing layout exists at load.
+    void EnsureCategoryDirs(const std::vector<std::string> &categories);
+
+    static std::string TimestampNow();
+
+private:
+    std::string rootDir_;
+};
