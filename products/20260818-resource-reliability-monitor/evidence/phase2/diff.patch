+ */
+#ifndef HIVIEW_PLUGINS_RELIABILITY_RESMON_TYPES_H
+#define HIVIEW_PLUGINS_RELIABILITY_RESMON_TYPES_H
+
+#include <cstdint>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace OHOS {
+namespace HiviewDFX {
+// One per-process CPU entry of the TopN list; cpuTicks is the per-tick delta of utime+stime.
+struct ProcCpuItem {
+    int32_t pid = 0;
+    std::string name;
+    uint64_t cpuTicks = 0;
+};
+
+// Whole-machine CPU sample. user/system/iowait/idle are per-tick deltas of /proc/stat counters.
+struct CpuSample {
+    uint64_t userTicks = 0;
+    uint64_t systemTicks = 0;
+    uint64_t iowaitTicks = 0;
+    uint64_t idleTicks = 0;
+    double load1 = 0;
+    double load5 = 0;
+    double load15 = 0;
+    std::vector<ProcCpuItem> procTop;
+
+    std::string ToText() const
+    {
+        std::ostringstream oss;
+        oss << "user=" << userTicks << " system=" << systemTicks << " iowait=" << iowaitTicks << " idle=" << idleTicks
+            << " load1=" << load1 << " load5=" << load5 << " load15=" << load15;
+        for (const auto &item : procTop) {
+            oss << " proc:" << item.name << "(" << item.pid << ")=" << item.cpuTicks;
+        }
+        return oss.str();
+    }
+};
+
+// One per-process memory entry of the TopN list; sizes in kB.
+struct ProcMemItem {
+    int32_t pid = 0;
+    std::string name;
+    uint64_t rssKb = 0;
+    uint64_t pssKb = 0;
+    uint64_t ussKb = 0;
+};
+
+// Memory sample. meminfo totals in kB; ionPresent=false means the ION interface is absent
+// on this kernel and the item was skipped (degrade, FR-MEM-03).
+struct MemSample {
+    uint64_t memTotalKb = 0;
+    uint64_t memFreeKb = 0;
+    uint64_t memAvailableKb = 0;
+    uint64_t cachedKb = 0;
+    uint64_t buffersKb = 0;
+    uint64_t swapTotalKb = 0;
+    uint64_t swapFreeKb = 0;
+    std::vector<ProcMemItem> procTop;
+    bool ionPresent = false;
+    uint64_t ionTotalKb = 0;
+
+    std::string ToText() const
+    {
+        std::ostringstream oss;
+        oss << "MemTotal=" << memTotalKb << "kB MemFree=" << memFreeKb << "kB MemAvailable=" << memAvailableKb
+            << "kB Cached=" << cachedKb << "kB Buffers=" << buffersKb << "kB SwapFree=" << swapFreeKb
+            << "kB ion=" << (ionPresent ? std::to_string(ionTotalKb) + "kB" : std::string("absent"));
+        for (const auto &item : procTop) {
+            oss << " mem:" << item.name << "(" << item.pid << ")rss=" << item.rssKb << "pss=" << item.pssKb
+                << "uss=" << item.ussKb;
+        }
+        return oss.str();
+    }
+};
+
+// Per-device disk IO of one tick; sectors/ms are per-tick deltas of /proc/diskstats counters.
+struct DiskIoItem {
+    std::string dev;
+    uint64_t readSectors = 0;
+    uint64_t writeSectors = 0;
+    uint64_t readMs = 0;
+    uint64_t writeMs = 0;
+    uint64_t ioMs = 0;
+};
+
+// Per-mount storage watermark; usedPct/inodeUsedPct in [0, 100].
+struct PartitionWaterItem {
+    std::string mount;
+    uint64_t totalKb = 0;
+    uint64_t availKb = 0;
+    double usedPct = 0;
+    double inodeUsedPct = 0;
+};
+
+struct IoSample {
+    std::vector<DiskIoItem> disks;
+    std::vector<PartitionWaterItem> partitions;
+
+    std::string ToText() const
+    {
+        std::ostringstream oss;
+        for (const auto &disk : disks) {
+            oss << " io:" << disk.dev << " rsec=" << disk.readSectors << " wsec=" << disk.writeSectors
+                << " rms=" << disk.readMs << " wms=" << disk.writeMs;
+        }
+        for (const auto &part : partitions) {
+            oss << " part:" << part.mount << " avail=" << part.availKb << "kB usedPct=" << part.usedPct
+                << " inodeUsedPct=" << part.inodeUsedPct;
+        }
+        return oss.str();
+    }
+};
+
+// One thermal zone; tempC in degrees Celsius, tripC lists configured trip points in degrees.
+struct ThermalZoneItem {
+    std::string zone;
+    std::string type;
+    int32_t tempC = 0;
+    std::vector<int32_t> tripC;
+
+    bool OverTrip() const
+    {
+        for (const auto &trip : tripC) {
+            if (tempC >= trip) {
+                return true;
+            }
+        }
+        return false;
+    }
+};
+
+struct PwrSample {
+    std::vector<ThermalZoneItem> zones;
+
+    std::string ToText() const
+    {
+        std::ostringstream oss;
+        for (const auto &zone : zones) {
+            oss << " zone:" << zone.zone << "(" << zone.type << ")=" << zone.tempC << "C";
+        }
+        return oss.str();
+    }
+};
+
+// Network sample aggregated over all non-loopback interfaces; counters are per-tick deltas.
+struct NetSample {
+    uint64_t rxBytes = 0;
+    uint64_t txBytes = 0;
+    uint64_t rxPackets = 0;
+    uint64_t txPackets = 0;
+    uint64_t rxErrors = 0;
+    uint64_t rxDropped = 0;
+
+    std::string ToText() const
+    {
+        std::ostringstream oss;
+        oss << "rxBytes=" << rxBytes << " txBytes=" << txBytes << " rxPackets=" << rxPackets
+            << " txPackets=" << txPackets << " rxErrors=" << rxErrors << " rxDropped=" << rxDropped;
+        return oss.str();
+    }
+};
+
+// A thread in uninterruptible (D) sleep, flagged per FR-THR-01.
+struct DThreadItem {
+    int32_t pid = 0;
+    int32_t tid = 0;
+    std::string comm;
+};
+
+// Per-thread scheduler-state distribution of one tick.
+struct ThrSample {
+    uint64_t runningCount = 0;
+    uint64_t uninterruptibleCount = 0;
+    uint64_t sleepingCount = 0;
+    uint64_t stoppedCount = 0;
+    std::vector<DThreadItem> dThreads;
+
+    std::string ToText() const
+    {
+        std::ostringstream oss;
+        oss << "R=" << runningCount << " D=" << uninterruptibleCount << " S=" << sleepingCount << " T=" << stoppedCount;
+        for (const auto &thread : dThreads) {
+            oss << " d:" << thread.comm << "(" << thread.pid << "/" << thread.tid << ")";
+        }
+        return oss.str();
+    }
+};
+
+// All six periodic samples of one tick, bundled so the collection pipeline passes
+// a single value instead of six out-parameters (G.FUN.01: keep the parameter
+// count of CollectAndLand within the recommended limit).
+struct ResmonSamples {
+    CpuSample cpu;
+    MemSample mem;
+    IoSample io;
+    PwrSample pwr;
+    NetSample net;
+    ThrSample thr;
+};
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // HIVIEW_PLUGINS_RELIABILITY_RESMON_TYPES_H
