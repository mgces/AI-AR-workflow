+#include "resmon_landing.h"
+
+#include <algorithm>
+#include <ctime>
+#include <dirent.h>
+#include <fstream>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+#include <vector>
+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+// hiview-owned landing dirs (owner rwx, group rx).
+constexpr int DIR_MODE = 0750;
+constexpr const char *FILE_PREFIX = "resmon_";
+constexpr const char *FILE_EXT = ".log";
+
+void EnsureDir(const std::string &dir)
+{
+    mkdir(dir.c_str(), DIR_MODE);
+}
+
+bool StartsWithResmon(const std::string &name)
+{
+    return name.rfind(FILE_PREFIX, 0) == 0;
+}
+} // namespace
+
+std::string ResmonLanding::TimestampNow()
+{
+    std::time_t now = std::time(nullptr);
+    struct tm tmVal = {};
+    localtime_r(&now, &tmVal);
+    char buf[16] = {0};
+    std::strftime(buf, sizeof(buf), "%Y%m%d%H%M%S", &tmVal);
+    return std::string(buf);
+}
+
+ResmonLanding::ResmonLanding(const std::string &rootDir) : rootDir_(rootDir)
+{
+    EnsureDir(rootDir_);
+}
+
+void ResmonLanding::EnsureCategoryDirs(const std::vector<std::string> &categories)
+{
+    for (const auto &category : categories) {
+        EnsureDir(rootDir_ + "/" + category);
+    }
+}
+
+bool ResmonLanding::Write(const std::string &category, const std::string &suffix, const std::string &text)
+{
+    std::string dir = rootDir_ + "/" + category;
+    EnsureDir(dir);
+    std::string path = dir + "/" + FILE_PREFIX + category;
+    if (!suffix.empty()) {
+        path += "_" + suffix;
+    }
+    path += "_" + TimestampNow() + FILE_EXT;
+    std::ofstream ofs(path, std::ios::out | std::ios::app);
+    if (!ofs.is_open()) {
+        return false;
+    }
+    ofs << text << "\n";
+    ofs.flush();
+    return true;
+}
+
+uint32_t ResmonLanding::RollingCleanup(const std::string &category, uint32_t maxFiles, uint64_t maxAgeSec)
+{
+    std::string dir = rootDir_ + "/" + category;
+    DIR *dirp = opendir(dir.c_str());
+    if (dirp == nullptr) {
+        return 0;
+    }
+    struct EntryInfo {
+        std::string path;
+        time_t mtime;
+    };
+    std::vector<EntryInfo> entries;
+    struct dirent *ent = nullptr;
+    while ((ent = readdir(dirp)) != nullptr) {
+        if (!StartsWithResmon(ent->d_name)) {
+            continue;
+        }
+        std::string path = dir + "/" + ent->d_name;
+        struct stat st = {};
+        if (stat(path.c_str(), &st) != 0) {
+            continue;
+        }
+        entries.push_back({path, st.st_mtime});
+    }
+    closedir(dirp);
+
+    uint32_t removed = 0;
+    std::time_t now = std::time(nullptr);
+    for (const auto &entry : entries) {
+        // age dimension: delete outright once past the retention window
+        if (maxAgeSec > 0 && static_cast<uint64_t>(now - entry.mtime) > maxAgeSec) {
+            if (unlink(entry.path.c_str()) == 0) {
+                ++removed;
+            }
+        }
+    }
+    // count dimension: newest first, delete everything beyond the quota
+    std::sort(entries.begin(), entries.end(), [](const EntryInfo &a, const EntryInfo &b) {
+        if (a.mtime != b.mtime) {
+            return a.mtime > b.mtime;
+        }
+        return a.path > b.path;
+    });
+    for (size_t i = static_cast<size_t>(maxFiles); i < entries.size(); ++i) {
+        if (unlink(entries[i].path.c_str()) == 0) {
+            ++removed;
+        }
+    }
+    return removed;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
