+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+// thermal zone temp/trip files report millidegrees; divide to degrees Celsius.
+constexpr int MILLI_PER_DEGREE = 1000;
+constexpr const char *ZONE_PREFIX = "thermal_zone";
+constexpr const char *TRIP_POINT_PREFIX = "trip_point_";
+constexpr const char *TRIP_POINT_SUFFIX = "_temp";
+
+bool ReadIntFile(const std::string &path, int32_t &out)
+{
+    std::ifstream ifs(path);
+    if (!ifs.is_open()) {
+        return false;
+    }
+    return static_cast<bool>(ifs >> out);
+}
+
+bool IsZoneDir(const std::string &name)
+{
+    return name.rfind(ZONE_PREFIX, 0) == 0;
+}
+} // namespace
+
+bool ResmonPwrCollector::ParseZoneTemp(const std::string &zoneDir, ThermalZoneItem &out)
+{
+    int32_t milli = 0;
+    if (!ReadIntFile(zoneDir + "/temp", milli)) {
+        return false;
+    }
+    out.tempC = milli / MILLI_PER_DEGREE;
+
+    DIR *dirp = opendir(zoneDir.c_str());
+    if (dirp == nullptr) {
+        return true; // temp known, trips unavailable -> degrade silently
+    }
+    struct dirent *ent = nullptr;
+    std::vector<int32_t> trips;
+    while ((ent = readdir(dirp)) != nullptr) {
+        std::string name = ent->d_name;
+        if (name.rfind(TRIP_POINT_PREFIX, 0) != 0) {
+            continue;
+        }
+        if (name.size() < std::string(TRIP_POINT_SUFFIX).size() ||
+            name.compare(name.size() - std::string(TRIP_POINT_SUFFIX).size(), std::string(TRIP_POINT_SUFFIX).size(),
+                         TRIP_POINT_SUFFIX) != 0) {
+            continue;
+        }
+        int32_t tripMilli = 0;
+        if (!ReadIntFile(zoneDir + "/" + name, tripMilli)) {
+            continue;
+        }
+        trips.push_back(tripMilli / MILLI_PER_DEGREE);
+    }
+    closedir(dirp);
+    std::sort(trips.begin(), trips.end());
+    out.tripC = trips;
+    return true;
+}
+
+bool ResmonPwrCollector::Collect(PwrSample &out)
+{
+    out = PwrSample();
+    std::string base = SysRoot() + "/class/thermal";
+    DIR *dirp = opendir(base.c_str());
+    if (dirp == nullptr) {
+        RecordError();
+        return false;
+    }
+    struct dirent *ent = nullptr;
+    while ((ent = readdir(dirp)) != nullptr) {
+        if (!IsZoneDir(ent->d_name)) {
+            continue;
+        }
+        ThermalZoneItem zone;
+        zone.zone = ent->d_name;
+        std::ifstream typeIfs(base + "/" + zone.zone + "/type");
+        if (typeIfs.is_open()) {
+            std::getline(typeIfs, zone.type);
+        }
+        if (!ParseZoneTemp(base + "/" + zone.zone, zone)) {
+            continue;
+        }
+        out.zones.push_back(zone);
+    }
+    closedir(dirp);
+    return true;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
