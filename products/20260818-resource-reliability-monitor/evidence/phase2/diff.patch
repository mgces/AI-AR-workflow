+#ifndef HIVIEW_PLUGINS_RELIABILITY_RESOURCE_MONITOR_PLUGIN_H
+#define HIVIEW_PLUGINS_RELIABILITY_RESOURCE_MONITOR_PLUGIN_H
+
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "event_loop.h"
+#include "plugin.h"
+#include "resmon_config.h"
+#include "resmon_cpu_collector.h"
+#include "resmon_event_listener.h"
+#include "resmon_io_collector.h"
+#include "resmon_landing.h"
+#include "resmon_mem_collector.h"
+#include "resmon_net_collector.h"
+#include "resmon_pwr_collector.h"
+#include "resmon_ring_buffer.h"
+#include "resmon_thr_collector.h"
+#include "resmon_threshold.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+// Resource reliability monitor plugin (FR-LC-01). One work-loop timer tick runs the whole
+// periodic pipeline: collect the six categories (each failure isolated) -> land text files
+// -> rolling cleanup -> ring-buffer push -> threshold evaluation for enhanced snapshots.
+// OnConfigUpdate only queues a reload request; ApplyConfig() runs at the top of the next
+// tick on the work loop, serialized with collection (config hot update takes effect the
+// next period, FR-CFG-02). The ring-buffer capacity is fixed at load: rebuilding the ring
+// on hot update would race the event snapshot thread that holds a raw pointer to it.
+class ResourceMonitorPlugin : public Plugin {
+public:
+    ResourceMonitorPlugin() = default;
+    ~ResourceMonitorPlugin() override = default;
+
+    bool ReadyToLoad() override;
+    void OnLoad() override;
+    void OnUnload() override;
+    void OnConfigUpdate(const std::string &localCfgPath, const std::string &cloudCfgPath) override;
+    // SysEventDispatcher (in every sys-event pipeline) forwards matching sys events here;
+    // real sys events do not flow through RegisterUnorderedEventListener in this build, so
+    // this callback is the sole event-trigger path (see design decision 4).
+    void OnEventListeningCallback(const Event &msg) override;
+    void Dump(int fd, const std::vector<std::string> &cmds) override;
+
+private:
+    void OnTimerTick();
+    void PollCloudConfig();
+    void ApplyConfig(const ResmonConfig &cfg);
+    void RebuildTimer();
+    void CollectAndLand(ResmonSamples &samples);
+    void HandleThreshold(ThresholdReason reason, const CpuSample &cpu, const MemSample &mem, const PwrSample &pwr);
+    std::string RingSummary(const CpuSample &cpu, const MemSample &mem, const PwrSample &pwr) const;
+    uint64_t NowMs() const;
+
+    std::shared_ptr<EventLoop> workLoop_;
+    ResmonConfig config_;
+    std::unique_ptr<ResmonCpuCollector> cpuCollector_;
+    std::unique_ptr<ResmonMemCollector> memCollector_;
+    std::unique_ptr<ResmonIoCollector> ioCollector_;
+    std::unique_ptr<ResmonPwrCollector> pwrCollector_;
+    std::unique_ptr<ResmonNetCollector> netCollector_;
+    std::unique_ptr<ResmonThrCollector> thrCollector_;
+    std::unique_ptr<ResmonThreshold> threshold_;
+    std::unique_ptr<ResmonLanding> landing_;
+    std::unique_ptr<ResmonRingBuffer> ring_;
+    std::shared_ptr<ResmonEventListener> listener_;
+    uint64_t timerSeq_ = 0;
+    // OnConfigUpdate runs on the framework param-update thread while OnTimerTick runs on
+    // the work loop: a direct config/threshold/collector mutation here would race the
+    // tick (UB). Only the dirty flag and the pending path are set here; the reload is
+    // applied on the next tick, serialized with collection.
+    std::atomic<bool> configDirty_{false};
+    std::mutex cfgPathMutex_;
+    std::string pendingCfgPath_;
+    // PollCloudConfig() caches the writable cloud config file stamp; a change queues the
+    // reload. On rk3568 dev boards the framework param-update dispatch is certificate-gated
+    // and never fires, so polling is the hot-update fallback that makes FR-CFG-02 observable.
+    uint64_t cloudCfgMtime_ = 0;
+    uint64_t cloudCfgSize_ = 0;
+};
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // HIVIEW_PLUGINS_RELIABILITY_RESOURCE_MONITOR_PLUGIN_H
