+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "resmon_threshold.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+constexpr uint64_t MS_PER_SEC = 1000;
+constexpr uint64_t KB_PER_MB = 1024;
+constexpr uint64_t PERCENT_SCALE = 100;
+} // namespace
+
+ResmonThreshold::ResmonThreshold(const ThresholdConfig &cfg) : cfg_(cfg) {}
+
+void ResmonThreshold::Reset()
+{
+    consecutive_.clear();
+    lastTriggerMs_ = 0;
+}
+
+ThresholdReason ResmonThreshold::CheckOver(const CpuSample &cpu, const MemSample &mem, const PwrSample &pwr) const
+{
+    uint64_t total = cpu.userTicks + cpu.systemTicks + cpu.iowaitTicks + cpu.idleTicks;
+    if (total > 0) {
+        uint64_t used = cpu.userTicks + cpu.systemTicks + cpu.iowaitTicks;
+        uint64_t cpuPct = (used * PERCENT_SCALE) / total;
+        if (cpuPct >= cfg_.cpuThresholdPct) {
+            return ThresholdReason::CPU_OVER;
+        }
+    }
+    uint64_t availThresholdKb = cfg_.memAvailThresholdMB * KB_PER_MB;
+    if (mem.memAvailableKb > 0 && mem.memAvailableKb < availThresholdKb) {
+        return ThresholdReason::MEM_LOW;
+    }
+    for (const auto &zone : pwr.zones) {
+        bool over = zone.OverTrip();
+        if (cfg_.tempThresholdC > 0 && zone.tempC >= cfg_.tempThresholdC) {
+            over = true;
+        }
+        if (over == true) {
+            return ThresholdReason::TEMP_OVER;
+        }
+    }
+    return ThresholdReason::NONE;
+}
+
+void ResmonThreshold::UpdateDebounce(ThresholdReason candidate)
+{
+    // Only the candidate reason accumulates; every other reason's streak resets
+    // (FR-TRG-05: M consecutive over-limit ticks of the same item).
+    for (auto &entry : consecutive_) {
+        if (entry.first != candidate) {
+            entry.second = 0;
+        }
+    }
+    if (candidate == ThresholdReason::NONE) {
+        return;
+    }
+    ++consecutive_[candidate];
+}
+
+bool ResmonThreshold::IntervalPassed(uint64_t nowMs) const
+{
+    if (lastTriggerMs_ == 0) {
+        return true;
+    }
+    return (nowMs - lastTriggerMs_) >= static_cast<uint64_t>(cfg_.minIntervalSec) * MS_PER_SEC;
+}
+
+ThresholdReason ResmonThreshold::Evaluate(const CpuSample &cpu, const MemSample &mem, const PwrSample &pwr,
+                                          uint64_t nowMs)
+{
+    if (!cfg_.thresholdEnabled) {
+        return ThresholdReason::NONE;
+    }
+    ThresholdReason candidate = CheckOver(cpu, mem, pwr);
+    UpdateDebounce(candidate);
+    if (candidate == ThresholdReason::NONE) {
+        return ThresholdReason::NONE;
+    }
+    if (consecutive_[candidate] < cfg_.debounce) {
+        return ThresholdReason::NONE;
+    }
+    if (!IntervalPassed(nowMs)) {
+        return ThresholdReason::NONE;
+    }
+    lastTriggerMs_ = nowMs;
+    return candidate;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
