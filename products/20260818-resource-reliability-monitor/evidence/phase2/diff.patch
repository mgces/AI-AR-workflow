+
+    std::string content = ConcatDir(TEST_ROOT + "/event");
+    EXPECT_NE(content.find("[pre-event]"), std::string::npos) << "环形缓冲回放现场";
+    EXPECT_NE(content.find("pre-tick-1"), std::string::npos);
+    EXPECT_NE(content.find("pre-tick-2"), std::string::npos);
+}
