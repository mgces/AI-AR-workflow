+class HiviewContext;
+class ResmonMemCollector;
+class ResmonThrCollector;
+
+// Event-bus listener (FR-TRG-02, FR-MEM-06, FR-THR-02, FR-STB-01/02/03). Subscribes to
+// the configured (domain,eventName) list; when a subscribed event arrives it synchronously
+// builds a comprehensive snapshot (instant meminfo + thread states + the pre-event ring
+// buffer context + event params) and lands it under event/ so the file exists within the
+// event callback (FR acceptance: snapshot within 500ms).
+// All back-pointers are non-owning: the owning ResourceMonitorPlugin outlives the listener.
+class ResmonEventListener : public EventListener {
+public:
+    struct Deps {
+        ResmonLanding *landing = nullptr;
+        ResmonRingBuffer *ring = nullptr;
+        ResmonMemCollector *memCollector = nullptr;
+        ResmonThrCollector *thrCollector = nullptr;
+    };
+
+    ResmonEventListener() = default;
+    ~ResmonEventListener() override = default;
+
+    // Registers this listener on the context for the subscribed event names. Returns
+    // false when the context is unavailable; a missing subscription list keeps the
+    // listener registered but idle (it filters every event).
+    bool Init(HiviewContext *context, const std::vector<ResmonEventSubscribe> &subscribes, const Deps &deps);
+
+    void OnUnorderedEvent(const Event &msg) override;
+    std::string GetListenerName() override;
+
+    // Test hook: build the snapshot text for an event without landing it.
+    std::string BuildSnapshotText(const Event &msg, const ResmonEventSubscribe &sub) const;
+
+private:
+    const ResmonEventSubscribe *Match(const std::string &eventName) const;
+
+    std::vector<ResmonEventSubscribe> subscribes_;
+    Deps deps_;
+};
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // HIVIEW_PLUGINS_RELIABILITY_RESMON_EVENT_LISTENER_H
