+
+namespace OHOS {
+namespace HiviewDFX {
+// Memory/ION collector (FR-MEM-01/02/03). meminfo is instantaneous; the per-process
+// TopN ranks by statm RSS (cheap) and resolves PSS/USS from smaps_rollup only for the
+// top N entries to bound the cost. ION usage is read from a configured kernel file and
+// is skipped with an error count when the interface is absent (degrade, FR-MEM-03).
+// Collect() runs only on the plugin work loop; ParseMeminfo is stateless and also used
+// by the event snapshot path.
+class ResmonMemCollector : public ResmonCollector {
+public:
+    ResmonMemCollector() : ResmonCollector("mem") {}
+    ~ResmonMemCollector() override = default;
+
+    bool Collect(MemSample &out, uint32_t topN);
+
+    static bool ParseMeminfo(const std::string &path, MemSample &out);
+
+    void SetIonUsagePath(const std::string &path);
+
+private:
+    void CollectProcTop(uint32_t topN, std::vector<ProcMemItem> &top);
+    void CollectIon(MemSample &out);
+
+    std::string ionUsagePath_;
+};
