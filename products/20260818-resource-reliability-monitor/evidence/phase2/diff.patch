+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "resmon_thr_collector.h"
+
+#include <dirent.h>
+#include <fstream>
+#include <sstream>
+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+// /proc/<pid>/task/<tid>/stat: the state letter is field 3, the first token after "comm)".
+constexpr int STAT_STATE_IDX = 0;
+
+bool IsNumDir(const std::string &name)
+{
+    if (name.empty()) {
+        return false;
+    }
+    for (char ch : name) {
+        if (ch < '0' || ch > '9') {
+            return false;
+        }
+    }
+    return true;
+}
+} // namespace
+
+bool ResmonThrCollector::ParseThreadStat(const std::string &path, std::string &comm, char &state)
+{
+    std::ifstream ifs(path);
+    if (!ifs.is_open()) {
+        return false;
+    }
+    std::string line;
+    if (!std::getline(ifs, line)) {
+        return false;
+    }
+    size_t close = line.rfind(')');
+    if (close == std::string::npos || close + 1 >= line.size()) {
+        return false;
+    }
+    size_t open = line.find('(');
+    if (open == std::string::npos || open + 1 > close) {
+        return false;
+    }
+    comm = line.substr(open + 1, close - open - 1);
+    std::istringstream iss(line.substr(close + 1));
+    std::string stateTok;
+    if (!(iss >> stateTok) || stateTok.empty()) {
+        return false;
+    }
+    state = stateTok[STAT_STATE_IDX];
+    return true;
+}
+
+void ResmonThrCollector::FoldThreadState(int32_t pid, int32_t tid, const std::string &comm, char state, ThrSample &out)
+{
+    switch (state) {
+        case 'R':
+            ++out.runningCount;
+            break;
+        case 'D':
+            ++out.uninterruptibleCount;
+            break;
+        case 'S':
+            ++out.sleepingCount;
+            break;
+        case 'T':
+            ++out.stoppedCount;
+            break;
+        default:
+            break;
+    }
+    if (state == 'D') {
+        DThreadItem item;
+        item.pid = pid;
+        item.tid = tid;
+        item.comm = comm;
+        out.dThreads.push_back(item);
+    }
+}
+
+void ResmonThrCollector::CollectProcessThreads(const std::string &taskDir, int32_t pid, ThrSample &out)
+{
+    DIR *taskDirp = opendir(taskDir.c_str());
+    if (taskDirp == nullptr) {
+        return; // process vanished mid-scan: skip, not an error
+    }
+    struct dirent *taskEnt = nullptr;
+    while ((taskEnt = readdir(taskDirp)) != nullptr) {
+        if (!IsNumDir(taskEnt->d_name)) {
+            continue;
+        }
+        std::string comm;
+        char state = '\0';
+        if (!ParseThreadStat(taskDir + "/" + taskEnt->d_name + "/stat", comm, state)) {
+            continue;
+        }
+        FoldThreadState(pid, std::stoi(taskEnt->d_name), comm, state, out);
+    }
+    closedir(taskDirp);
+}
+
+bool ResmonThrCollector::Collect(ThrSample &out)
+{
+    out = ThrSample();
+    std::string procRoot = ProcRoot();
+    DIR *procDir = opendir(procRoot.c_str());
+    if (procDir == nullptr) {
+        RecordError();
+        return false;
+    }
+    struct dirent *procEnt = nullptr;
+    while ((procEnt = readdir(procDir)) != nullptr) {
+        if (!IsNumDir(procEnt->d_name)) {
+            continue;
+        }
+        std::string taskDir = procRoot + "/" + procEnt->d_name + "/task";
+        CollectProcessThreads(taskDir, std::stoi(procEnt->d_name), out);
+    }
+    closedir(procDir);
+    return true;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
