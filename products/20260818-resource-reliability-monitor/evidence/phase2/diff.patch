+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#ifndef HIVIEW_PLUGINS_RELIABILITY_RESMON_COLLECTOR_H
+#define HIVIEW_PLUGINS_RELIABILITY_RESMON_COLLECTOR_H
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <string>
+
+namespace OHOS {
+namespace HiviewDFX {
+// Common base of the category collectors: identity, injectable /proc+/sys roots and a
+// per-collector error counter (FR-ERR-01). The roots are mutex-guarded because they are
+// written by ApplyConfig on the work loop while the event snapshot path reads them from
+// the framework event dispatch thread; the error counter is atomic because Dump may read
+// it from another thread. All other state lives in the derived collectors and is touched
+// only from the work loop.
+class ResmonCollector {
+public:
+    explicit ResmonCollector(const std::string &name) : name_(name), procRoot_("/proc"), sysRoot_("/sys") {}
+    virtual ~ResmonCollector() = default;
+
+    const std::string &Name() const
+    {
+        return name_;
+    }
+
+    uint64_t ErrorCount() const
+    {
+        return errorCount_.load(std::memory_order_relaxed);
+    }
+
+    void SetProcRoot(const std::string &root)
+    {
+        std::lock_guard<std::mutex> lk(rootMutex_);
+        procRoot_ = root;
+    }
+
+    void SetSysRoot(const std::string &root)
+    {
+        std::lock_guard<std::mutex> lk(rootMutex_);
+        sysRoot_ = root;
+    }
+
+    // Returns a copy: callers on other threads must not hold the internal string.
+    std::string ProcRoot() const
+    {
+        std::lock_guard<std::mutex> lk(rootMutex_);
+        return procRoot_;
+    }
+
+    std::string SysRoot() const
+    {
+        std::lock_guard<std::mutex> lk(rootMutex_);
+        return sysRoot_;
+    }
+
+protected:
+    void RecordError()
+    {
+        errorCount_.fetch_add(1, std::memory_order_relaxed);
+    }
+
+private:
+    std::string name_;
+    std::atomic<uint64_t> errorCount_{0};
+    mutable std::mutex rootMutex_;
+    std::string procRoot_;
+    std::string sysRoot_;
+};
+} // namespace HiviewDFX
+} // namespace OHOS
+#endif // HIVIEW_PLUGINS_RELIABILITY_RESMON_COLLECTOR_H
diff --git a/plugins/reliability/resource_monitor/resmon_config.cpp b/plugins/reliability/resource_monitor/resmon_config.cpp
new file mode 100644
index 00000000..599d34c1
--- /dev/null
+++ b/plugins/reliability/resource_monitor/resmon_config.cpp
@@ -0,0 +1,180 @@
+/*
+ * Copyright (c) 2026 Huawei Device Co., Ltd.
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "resmon_config.h"
+
+#include <fstream>
+
+#include "cJSON.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+constexpr uint32_t MIN_PERIOD_SEC = 1;
+// Default event-bus subscriptions (FR-TRG-02/FR-STB-01). All names verified against
+// event sources in this source tree; matching on the bus is by event name.
+constexpr const char *KIND_FREEZE = "freeze";
+constexpr const char *KIND_GENERIC = "GENERIC";
+constexpr const char *SUFFIX_FREEZE = "freeze";
+constexpr const char *SUFFIX_SCREEN = "screen";
+constexpr const char *EVENT_THREAD_BLOCK = "THREAD_BLOCK_3S";
+constexpr const char *EVENT_LIFECYCLE_TIMEOUT = "LIFECYCLE_HALF_TIMEOUT";
+constexpr const char *EVENT_SCREEN_ON = "SCREEN_ON";
+
+void ReadBool(const cJSON *root, const char *key, bool &out)
+{
+    const cJSON *node = cJSON_GetObjectItem(root, key);
+    if (node != nullptr && cJSON_IsBool(node)) {
+        out = cJSON_IsTrue(node);
+    }
+}
+
+void ReadUInt(const cJSON *root, const char *key, uint32_t &out)
+{
+    const cJSON *node = cJSON_GetObjectItem(root, key);
+    if (node != nullptr && cJSON_IsNumber(node) && node->valuedouble >= 0) {
+        out = static_cast<uint32_t>(node->valuedouble);
+    }
+}
+
+void ReadUInt64(const cJSON *root, const char *key, uint64_t &out)
+{
+    const cJSON *node = cJSON_GetObjectItem(root, key);
+    if (node != nullptr && cJSON_IsNumber(node) && node->valuedouble >= 0) {
+        out = static_cast<uint64_t>(node->valuedouble);
+    }
+}
+
+void ReadInt(const cJSON *root, const char *key, int32_t &out)
+{
+    const cJSON *node = cJSON_GetObjectItem(root, key);
+    if (node != nullptr && cJSON_IsNumber(node)) {
+        out = static_cast<int32_t>(node->valuedouble);
+    }
+}
+
+void ReadString(const cJSON *root, const char *key, std::string &out)
+{
+    const cJSON *node = cJSON_GetObjectItem(root, key);
+    if (node != nullptr && cJSON_IsString(node) && node->valuestring != nullptr) {
+        out = node->valuestring;
+    }
+}
+
+void ReadStringArray(const cJSON *root, const char *key, std::vector<std::string> &out)
+{
+    const cJSON *arr = cJSON_GetObjectItem(root, key);
+    if (arr == nullptr || !cJSON_IsArray(arr)) {
+        return;
+    }
+    std::vector<std::string> parsed;
+    const cJSON *node = nullptr;
+    cJSON_ArrayForEach(node, arr)
+    {
+        if (cJSON_IsString(node) && node->valuestring != nullptr) {
+            parsed.push_back(node->valuestring);
+        }
+    }
+    if (!parsed.empty()) {
+        out = parsed;
+    }
+}
+
+void ReadEvents(const cJSON *root, std::vector<ResmonEventSubscribe> &out)
+{
+    const cJSON *arr = cJSON_GetObjectItem(root, "events");
+    if (arr == nullptr || !cJSON_IsArray(arr)) {
+        return;
+    }
+    std::vector<ResmonEventSubscribe> parsed;
+    const cJSON *node = nullptr;
+    cJSON_ArrayForEach(node, arr)
+    {
+        ResmonEventSubscribe sub;
+        ReadString(node, "domain", sub.domain);
+        ReadString(node, "name", sub.name);
+        ReadString(node, "kind", sub.kind);
+        ReadString(node, "suffix", sub.suffix);
+        if (!sub.name.empty() && !sub.suffix.empty()) {
+            parsed.push_back(sub);
+        }
+    }
+    if (!parsed.empty()) {
+        out = parsed;
+    }
+}
+} // namespace
+
+ResmonConfig ResmonConfig::LoadDefault()
+{
+    ResmonConfig cfg;
+    ResmonEventSubscribe block;
+    block.domain = "AAFWK";
+    block.name = EVENT_THREAD_BLOCK;
+    block.kind = KIND_FREEZE;
+    block.suffix = SUFFIX_FREEZE;
+    cfg.events.push_back(block);
+    ResmonEventSubscribe lifecycle;
+    lifecycle.domain = "AAFWK";
+    lifecycle.name = EVENT_LIFECYCLE_TIMEOUT;
+    lifecycle.kind = KIND_FREEZE;
+    lifecycle.suffix = SUFFIX_FREEZE;
+    cfg.events.push_back(lifecycle);
+    ResmonEventSubscribe screen;
+    screen.domain = "POWER";
+    screen.name = EVENT_SCREEN_ON;
+    screen.kind = KIND_GENERIC;
+    screen.suffix = SUFFIX_SCREEN;
+    cfg.events.push_back(screen);
+    return cfg;
+}
+
+ResmonConfig ResmonConfig::Load(const std::string &path)
+{
+    std::ifstream ifs(path);
+    if (!ifs.is_open()) {
+        return LoadDefault();
+    }
+    std::string content((std::istreambuf_iterator<char>(ifs)), std::istreambuf_iterator<char>());
+    cJSON *root = cJSON_Parse(content.c_str());
+    if (root == nullptr) {
+        return LoadDefault();
+    }
+    ResmonConfig cfg;
+    ReadUInt(root, "periodSec", cfg.periodSec);
+    ReadUInt(root, "topN", cfg.topN);
+    ReadUInt(root, "quotaFiles", cfg.quotaFiles);
+    ReadUInt64(root, "retentionSec", cfg.retentionSec);
+    ReadUInt64(root, "ringCapacity", cfg.ringCapacity);
+    ReadString(root, "procRoot", cfg.procRoot);
+    ReadString(root, "sysRoot", cfg.sysRoot);
+    ReadString(root, "ionUsagePath", cfg.ionUsagePath);
+    ReadStringArray(root, "mountPoints", cfg.mountPoints);
+    ReadBool(root, "periodicEnabled", cfg.thresholds.periodicEnabled);
+    ReadBool(root, "eventEnabled", cfg.thresholds.eventEnabled);
+    ReadBool(root, "thresholdEnabled", cfg.thresholds.thresholdEnabled);
+    ReadUInt(root, "cpuThresholdPct", cfg.thresholds.cpuThresholdPct);
+    ReadUInt64(root, "memAvailThresholdMB", cfg.thresholds.memAvailThresholdMB);
+    ReadInt(root, "tempThresholdC", cfg.thresholds.tempThresholdC);
+    ReadUInt(root, "debounce", cfg.thresholds.debounce);
+    ReadUInt(root, "minIntervalSec", cfg.thresholds.minIntervalSec);
+    ReadEvents(root, cfg.events);
+    cJSON_Delete(root);
+    if (cfg.periodSec < MIN_PERIOD_SEC) {
+        cfg.periodSec = MIN_PERIOD_SEC; // FR-TRG-01: minimum polling period 1s
+    }
+    return cfg;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
