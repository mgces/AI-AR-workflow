+ * limitations under the License.
+ */
+#include "resmon_io_collector.h"
+
+#include <algorithm>
+#include <fstream>
+#include <sstream>
+#include <sys/statfs.h>
+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+// /proc/diskstats columns: major minor name reads reads_merged read_sectors read_ms
+// writes writes_merged write_sectors write_ms in_progress io_ms weighted_ms.
+constexpr int DISKSTATS_NAME_IDX = 2;
+constexpr int DISKSTATS_READ_SECTORS_IDX = 5;
+constexpr int DISKSTATS_READ_MS_IDX = 6;
+constexpr int DISKSTATS_WRITE_SECTORS_IDX = 9;
+constexpr int DISKSTATS_WRITE_MS_IDX = 10;
+constexpr int DISKSTATS_IO_MS_IDX = 12;
+// skip virtual/ram devices that never carry real workload
+constexpr const char *SKIP_DEV_PREFIX_1 = "loop";
+constexpr const char *SKIP_DEV_PREFIX_2 = "ram";
+constexpr double PERCENT_SCALE = 100.0;
+
+bool ShouldSkipDev(const std::string &dev)
+{
+    return dev.rfind(SKIP_DEV_PREFIX_1, 0) == 0 || dev.rfind(SKIP_DEV_PREFIX_2, 0) == 0;
+}
+
+// Cumulative-counter delta; clamps to zero when the counter reset (device re-registered).
+uint64_t DeltaClamp(uint64_t current, uint64_t prev)
+{
+    return (current >= prev) ? current - prev : 0;
+}
+} // namespace
+
+bool ResmonIoCollector::ParseDiskstats(const std::string &path, std::vector<DiskIoItem> &out)
+{
+    out.clear();
+    std::ifstream ifs(path);
+    if (!ifs.is_open()) {
+        return false;
+    }
+    std::string line;
+    while (std::getline(ifs, line)) {
+        std::istringstream iss(line);
+        std::vector<std::string> toks;
+        std::string tok;
+        while (iss >> tok) {
+            toks.push_back(tok);
+        }
+        if (toks.size() <= DISKSTATS_IO_MS_IDX) {
+            continue;
+        }
+        if (ShouldSkipDev(toks[DISKSTATS_NAME_IDX])) {
+            continue;
+        }
+        DiskIoItem item;
+        item.dev = toks[DISKSTATS_NAME_IDX];
+        item.readSectors = std::stoull(toks[DISKSTATS_READ_SECTORS_IDX]);
+        item.readMs = std::stoull(toks[DISKSTATS_READ_MS_IDX]);
+        item.writeSectors = std::stoull(toks[DISKSTATS_WRITE_SECTORS_IDX]);
+        item.writeMs = std::stoull(toks[DISKSTATS_WRITE_MS_IDX]);
+        item.ioMs = std::stoull(toks[DISKSTATS_IO_MS_IDX]);
+        out.push_back(item);
+    }
+    return true;
+}
+
+bool ResmonIoCollector::ReadPartitionWater(const std::string &mount, PartitionWaterItem &out)
+{
+    struct statfs st = {};
+    if (statfs(mount.c_str(), &st) != 0) {
+        return false;
+    }
+    out.mount = mount;
+    uint64_t blockSizeKb = static_cast<uint64_t>(st.f_bsize) / 1024; // 1024: bytes per kB
+    out.totalKb = static_cast<uint64_t>(st.f_blocks) * blockSizeKb;
+    out.availKb = static_cast<uint64_t>(st.f_bavail) * blockSizeKb;
+    if (st.f_blocks > 0) {
+        uint64_t used = static_cast<uint64_t>(st.f_blocks) - static_cast<uint64_t>(st.f_bfree);
+        out.usedPct = (static_cast<double>(used) / static_cast<double>(st.f_blocks)) * PERCENT_SCALE;
+    }
+    if (st.f_files > 0) {
+        uint64_t usedInodes = static_cast<uint64_t>(st.f_files) - static_cast<uint64_t>(st.f_ffree);
+        out.inodeUsedPct = (static_cast<double>(usedInodes) / static_cast<double>(st.f_files)) * PERCENT_SCALE;
+    }
+    return true;
+}
+
+bool ResmonIoCollector::Collect(IoSample &out)
+{
+    out = IoSample();
+    std::vector<DiskIoItem> current;
+    if (!ParseDiskstats(ProcRoot() + "/diskstats", current)) {
+        RecordError();
+        return false;
+    }
+    for (auto &item : current) {
+        DiskIoItem delta = item;
+        auto it = prev_.find(item.dev);
+        if (it != prev_.end()) {
+            delta.readSectors = DeltaClamp(item.readSectors, it->second.readSectors);
+            delta.writeSectors = DeltaClamp(item.writeSectors, it->second.writeSectors);
+            delta.readMs = DeltaClamp(item.readMs, it->second.readMs);
+            delta.writeMs = DeltaClamp(item.writeMs, it->second.writeMs);
+            delta.ioMs = DeltaClamp(item.ioMs, it->second.ioMs);
+            it->second = item; // advance the baseline to the current cumulative counters
+        } else {
+            delta.readSectors = 0;
+            delta.writeSectors = 0;
+            delta.readMs = 0;
+            delta.writeMs = 0;
+            delta.ioMs = 0;
+            prev_[item.dev] = item;
+        }
+        out.disks.push_back(delta);
+    }
+    for (const auto &mount : mountPoints_) {
+        PartitionWaterItem water;
+        if (ReadPartitionWater(mount, water)) {
+            out.partitions.push_back(water);
+        }
+    }
+    return true;
+}
+
+void ResmonIoCollector::SetMountPoints(const std::vector<std::string> &mounts)
+{
+    mountPoints_ = mounts;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
