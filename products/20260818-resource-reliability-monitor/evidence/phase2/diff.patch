+ * limitations under the License.
+ */
+#include "resmon_net_collector.h"
+
+#include <fstream>
+#include <sstream>
+
+namespace OHOS {
+namespace HiviewDFX {
+namespace {
+// /proc/net/dev line: "ifname: rx_bytes rx_packets rx_errs rx_drop rx_fifo rx_frame rx_compressed rx_multicast
+// tx_bytes tx_packets tx_errs tx_drop ..." - read the counters we report and skip the rest.
+constexpr const char *LOOPBACK_IF = "lo";
+constexpr int NET_DEV_RX_BYTES_IDX = 0;
+constexpr int NET_DEV_RX_PACKETS_IDX = 1;
+constexpr int NET_DEV_RX_ERRORS_IDX = 2;
+constexpr int NET_DEV_RX_DROP_IDX = 3;
+constexpr int NET_DEV_TX_BYTES_IDX = 8;
+constexpr int NET_DEV_TX_PACKETS_IDX = 9;
+
+bool ParseLine(const std::string &line, NetSample &out)
+{
+    size_t colon = line.find(':');
+    if (colon == std::string::npos) {
+        return false;
+    }
+    std::string ifname = line.substr(0, colon);
+    // /proc/net/dev right-pads interface names to the header column width, so a
+    // line arrives as "    lo: ..." and must be trimmed before the loopback
+    // comparison below; otherwise loopback leaks into the reported aggregate.
+    const size_t nameStart = ifname.find_first_not_of(" \t");
+    const size_t nameEnd = ifname.find_last_not_of(" \t");
+    if (nameStart == std::string::npos || nameEnd == std::string::npos) {
+        return false;
+    }
+    ifname = ifname.substr(nameStart, nameEnd - nameStart + 1);
+    NetSample add;
+    std::istringstream iss(line.substr(colon + 1));
+    uint64_t counters[NET_DEV_TX_PACKETS_IDX + 1] = {0};
+    for (int i = 0; i <= NET_DEV_TX_PACKETS_IDX; ++i) {
+        if (!(iss >> counters[i])) {
+            return false;
+        }
+    }
+    add.rxBytes = counters[NET_DEV_RX_BYTES_IDX];
+    add.rxPackets = counters[NET_DEV_RX_PACKETS_IDX];
+    add.rxErrors = counters[NET_DEV_RX_ERRORS_IDX];
+    add.rxDropped = counters[NET_DEV_RX_DROP_IDX];
+    add.txBytes = counters[NET_DEV_TX_BYTES_IDX];
+    add.txPackets = counters[NET_DEV_TX_PACKETS_IDX];
+    if (ifname == LOOPBACK_IF) {
+        return true; // parsed, but loopback traffic is excluded from the aggregate
+    }
+    out.rxBytes += add.rxBytes;
+    out.rxPackets += add.rxPackets;
+    out.rxErrors += add.rxErrors;
+    out.rxDropped += add.rxDropped;
+    out.txBytes += add.txBytes;
+    out.txPackets += add.txPackets;
+    return true;
+}
+
+// Cumulative-counter delta; clamps to zero when the counter reset (interface re-created).
+uint64_t DeltaClamp(uint64_t current, uint64_t prev)
+{
+    return (current >= prev) ? current - prev : 0;
+}
+} // namespace
+
+bool ResmonNetCollector::ParseNetDev(const std::string &path, NetSample &out)
+{
+    out = NetSample();
+    std::ifstream ifs(path);
+    if (!ifs.is_open()) {
+        return false;
+    }
+    std::string line;
+    std::getline(ifs, line); // header
+    std::getline(ifs, line); // header
+    bool any = false;
+    while (std::getline(ifs, line)) {
+        if (ParseLine(line, out)) {
+            any = true;
+        }
+    }
+    return any;
+}
+
+bool ResmonNetCollector::Collect(NetSample &out)
+{
+    NetSample current;
+    if (!ParseNetDev(ProcRoot() + "/net/dev", current)) {
+        RecordError();
+        return false;
+    }
+    out = NetSample();
+    out.rxBytes = DeltaClamp(current.rxBytes, prev_.rxBytes);
+    out.rxPackets = DeltaClamp(current.rxPackets, prev_.rxPackets);
+    out.rxErrors = DeltaClamp(current.rxErrors, prev_.rxErrors);
+    out.rxDropped = DeltaClamp(current.rxDropped, prev_.rxDropped);
+    out.txBytes = DeltaClamp(current.txBytes, prev_.txBytes);
+    out.txPackets = DeltaClamp(current.txPackets, prev_.txPackets);
+    prev_ = current;
+    return true;
+}
+} // namespace HiviewDFX
+} // namespace OHOS
