+#include "fd_leak_detector.h"
+
+#include <cctype>
+#include <dirent.h>
+#include <string>
+
+#include "event_loop.h"
+#include "file_util.h"
+#include "hiview_logger.h"
+#include "plugin_factory.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+REGISTER(FdLeakDetector);
+DEFINE_LOG_TAG("FdLeakDetector");
+
+namespace {
+const std::string FD_LEAK_OUTPUT_DIR = "/data/log/reliability/resource_leak/fd_leak/";
+const std::string FD_LEAK_RECORD_FILE = "fd_leak_record";
+} // namespace
+
+void FdLeakDetector::OnLoad()
+{
+    SetName("FdLeakDetector");
+    SetVersion("FdLeakDetector1.0");
+    auto context = GetHiviewContext();
+    if (context == nullptr) {
+        HIVIEW_LOGE("hiview context is null");
+        return;
+    }
+
+    outputDir_ = FD_LEAK_OUTPUT_DIR;
+    if (!FileUtil::FileExists(outputDir_)) {
+        if (!FileUtil::ForceCreateDirectory(outputDir_)) {
+            HIVIEW_LOGE("failed to create output dir: %{public}s", outputDir_.c_str());
+            return;
+        }
+    }
+    InitWorkLoop();
+    HIVIEW_LOGI("FdLeakDetector loaded");
+}
+
+void FdLeakDetector::InitWorkLoop()
+{
+    workLoop_ = GetHiviewContext()->GetSharedWorkLoop();
+    if (workLoop_ == nullptr) {
+        HIVIEW_LOGE("workLoop is null");
+        return;
+    }
+    auto task = [this] { this->CheckFdLeak(); };
+    timerSeqId_ = workLoop_->AddTimerEvent(nullptr, nullptr, task, kCheckIntervalSec, true);
+    HIVIEW_LOGI("fd leak check timer started, interval=%{public}d", kCheckIntervalSec);
+}
+
+void FdLeakDetector::OnUnload()
+{
+    if (workLoop_ != nullptr && timerSeqId_ > 0) {
+        workLoop_->RemoveEvent(timerSeqId_);
+    }
+    HIVIEW_LOGI("FdLeakDetector unloaded");
+}
+
+bool FdLeakDetector::OnEvent(std::shared_ptr<Event> &event)
+{
+    return false;
+}
+
+void FdLeakDetector::CheckFdLeak()
+{
+    auto dir = opendir("/proc");
+    if (dir == nullptr) {
+        HIVIEW_LOGE("failed to open /proc, errno=%{public}d", errno);
+        return;
+    }
+
+    for (struct dirent *ent = readdir(dir); ent != nullptr; ent = readdir(dir)) {
+        std::string name(ent->d_name);
+        if (name == "." || name == "..") {
+            continue;
+        }
+        // only process directories with all-digit names (pids)
+        if (ent->d_type != DT_DIR || name.empty() || !std::isdigit(name[0])) {
+            continue;
+        }
+        bool isAllDigit = true;
+        for (char c : name) {
+            if (!std::isdigit(c)) {
+                isAllDigit = false;
+                break;
+            }
+        }
+        if (!isAllDigit) {
+            continue;
+        }
+
+        int fdCount = CountFds(name);
+        if (fdCount > kFdThreshold) {
+            HIVIEW_LOGW("pid %{public}s fd count %{public}d exceeds threshold %{public}d", name.c_str(), fdCount,
+                        kFdThreshold);
+            WriteLeakRecord(name, fdCount);
+        }
+    }
+    closedir(dir);
+}
+
+int FdLeakDetector::CountFds(const std::string &pid)
+{
+    std::string fdPath = "/proc/" + pid + "/fd";
+    auto fdDir = opendir(fdPath.c_str());
+    if (fdDir == nullptr) {
+        // process may have exited or permission denied
+        return -1;
+    }
+
+    int count = 0;
+    for (struct dirent *ent = readdir(fdDir); ent != nullptr; ent = readdir(fdDir)) {
+        if (ent->d_name[0] != '.') {
+            count++;
+        }
+    }
+    closedir(fdDir);
+    return count;
+}
+
+void FdLeakDetector::WriteLeakRecord(const std::string &pid, int fdCount)
+{
+    std::string filePath = outputDir_ + FD_LEAK_RECORD_FILE;
+    std::string record = "pid=" + pid + " fd_count=" + std::to_string(fdCount) + "\n";
+    FileUtil::SaveStringToFile(filePath, record, false); // false = append mode
+}
+} // namespace HiviewDFX
+} // namespace OHOS
