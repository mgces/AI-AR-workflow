+#ifndef HIVIEW_PLUGINS_FD_LEAK_DETECTOR_H
+#define HIVIEW_PLUGINS_FD_LEAK_DETECTOR_H
+
+#include <string>
+
+#include "plugin.h"
+
+namespace OHOS {
+namespace HiviewDFX {
+class FdLeakDetector : public Plugin {
+public:
+    FdLeakDetector(){};
+    ~FdLeakDetector(){};
+    void OnLoad() override;
+    void OnUnload() override;
