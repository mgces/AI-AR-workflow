+#include <gtest/gtest.h>
+#include <fstream>
+#include <string>
+
+#include "fd_leak_detector.h"
+#include "file_util.h"
+#include "hiview_logger.h"
+#include "plugin_factory.h"
+
+using namespace std;
+using namespace testing;
+using namespace testing::ext;
+
+namespace OHOS {
+namespace HiviewDFX {
+class FdLeakDetectorUnitTest : public testing::Test {
+public:
+    void SetUp() override;
+    void TearDown() override;
+    static void SetUpTestCase();
+    static void TearDownTestCase();
+
+    static const string tempDir_;
+};
+
+const string FdLeakDetectorUnitTest::tempDir_ = "/data/local/tmp/fd_leak_test/";
+
+void FdLeakDetectorUnitTest::SetUpTestCase() {}
+
+void FdLeakDetectorUnitTest::TearDownTestCase()
+{
+    FileUtil::ForceRemoveDirectory(tempDir_);
+}
+
+void FdLeakDetectorUnitTest::SetUp()
+{
+    FileUtil::ForceCreateDirectory(tempDir_);
+}
+
+void FdLeakDetectorUnitTest::TearDown()
+{
+    FileUtil::ForceRemoveDirectory(tempDir_);
+}
+
+/**
+ * @tc.name: FdLeakDetectorUnitTest001
+ * @tc.desc: test plugin create and destroy
+ * @tc.type: FUNC
+ */
+HWTEST_F(FdLeakDetectorUnitTest, FdLeakDetectorUnitTest001, TestSize.Level0)
+{
+    /**
+     * @tc.steps: step1. create FdLeakDetector instance
+     * @tc.expect: instance is not null
+     */
+    auto plugin = make_shared<FdLeakDetector>();
+    ASSERT_NE(plugin, nullptr);
+
+    /**
+     * @tc.steps: step2. verify OnEvent returns false (no event handling)
+     * @tc.expect: OnEvent returns false
+     */
+    shared_ptr<Event> event = nullptr;
+    ASSERT_FALSE(plugin->OnEvent(event));
+}
+
+/**
+ * @tc.name: FdLeakDetectorUnitTest002
+ * @tc.desc: test WriteLeakRecord writes file correctly
+ * @tc.type: FUNC
+ */
+HWTEST_F(FdLeakDetectorUnitTest, FdLeakDetectorUnitTest002, TestSize.Level0)
+{
+    /**
+     * @tc.steps: step1. set output dir to temp dir and write record
+     * @tc.expect: file is created with correct content
+     */
+    auto plugin = make_shared<FdLeakDetector>();
+    ASSERT_NE(plugin, nullptr);
+
+    plugin->outputDir_ = tempDir_;
+    plugin->WriteLeakRecord("12345", 6000);
+
+    string filePath = tempDir_ + "fd_leak_record";
+    string content;
+    ASSERT_TRUE(FileUtil::LoadStringFromFile(filePath, content));
+    ASSERT_TRUE(content.find("pid=12345") != string::npos);
+    ASSERT_TRUE(content.find("fd_count=6000") != string::npos);
+}
+
+/**
+ * @tc.name: FdLeakDetectorUnitTest003
+ * @tc.desc: test CountFds with real /proc/self/fd
+ * @tc.type: FUNC
+ */
+HWTEST_F(FdLeakDetectorUnitTest, FdLeakDetectorUnitTest003, TestSize.Level0)
+{
+    /**
+     * @tc.steps: step1. call CountFds with "self" (current process)
+     * @tc.expect: returns a positive count (current process always has some fds)
+     */
+    auto plugin = make_shared<FdLeakDetector>();
+    ASSERT_NE(plugin, nullptr);
+
+    int count = plugin->CountFds("self");
+    ASSERT_GT(count, 0);
+}
+
+/**
+ * @tc.name: FdLeakDetectorUnitTest004
+ * @tc.desc: test CountFds with non-existent pid returns -1
+ * @tc.type: FUNC
+ */
+HWTEST_F(FdLeakDetectorUnitTest, FdLeakDetectorUnitTest004, TestSize.Level1)
+{
+    /**
+     * @tc.steps: step1. call CountFds with a non-existent pid
+     * @tc.expect: returns -1 (directory not found)
+     */
+    auto plugin = make_shared<FdLeakDetector>();
+    ASSERT_NE(plugin, nullptr);
+
+    int count = plugin->CountFds("99999999");
+    ASSERT_EQ(count, -1);
+}
+
+/**
+ * @tc.name: FdLeakDetectorUnitTest005
+ * @tc.desc: test FD_THRESHOLD constant is 5000
+ * @tc.type: FUNC
+ */
+HWTEST_F(FdLeakDetectorUnitTest, FdLeakDetectorUnitTest005, TestSize.Level1)
+{
+    /**
+     * @tc.steps: step1. verify threshold constant
+     * @tc.expect: FD_THRESHOLD equals 5000
+     */
+    ASSERT_EQ(FdLeakDetector::kFdThreshold, 5000);
+}
