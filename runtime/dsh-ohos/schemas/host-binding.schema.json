{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ar-workflow.local/schemas/host-binding.schema.json",
  "title": "OHOS DSH host binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id", "host_kind", "capabilities", "capability_source", "idempotency_key"
  ],
  "properties": {
    "binding_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "host_kind": { "enum": ["codex", "claude-code", "cursor", "trae", "other"] },
    "host_version": { "type": "string", "maxLength": 128 },
    "execution_mode": { "enum": ["host_native", "external"], "default": "host_native" },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "capability_source": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
