__pycache__/
*.pyc

# Local upstream staging copy. Installable skills must live under root skills/.
/openharmony-skills/

# pipeline run-state / evidence (machine-specific, never commit)
specs/
examples/specs/
*.build-probe-ok
.lifecycle-secret/
.dsh-ohos/

# archived product RAW run-state — may carry device serials / personal paths.
# Only redacted summaries (ar.md, manifest_summary.md, README.md) may be committed;
# generate them with skills/ohos-ar-dev-workflow/scripts/archive_product.py.
products/**/evidence/
products/**/pipeline.json
products/**/pipeline-state/
products/**/*_manifest.jsonl
products/**/*.log
skills/code-ruleset-style-check/s/

# knowledge base persists stable navigation only. Dynamic source snapshots and
# the local BM25 index are rebuilt/queried from the active OHOS checkout.
openharmony-knowledge-base/generated/
openharmony-knowledge-base/workspace/
openharmony-knowledge-base/source-domains/
openharmony-knowledge-base/products/
openharmony-knowledge-base/subsystems/**/foundation-*.md
openharmony-knowledge-base/subsystems/**/functional-overview.md
openharmony-knowledge-base/subsystems/**/developtools-*.md
openharmony-knowledge-base/subsystems/**/hiviewdfx-index.md
openharmony-knowledge-base/subsystems/**/README.generated.md

# docs site (VitePress) — commit source only; deps + build output are derived.
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
