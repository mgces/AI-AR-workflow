[Unit]
Description=DSH Workspace Gateway for workspace %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/opt/dsh/AI-AR-workflow
EnvironmentFile=/etc/dsh/gateways/%i.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/dsh/AI-AR-workflow/workspace-gateway/bin/workspace-gateway.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
Delegate=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dsh /var/log/dsh /srv/dsh/workspaces
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=16G
TasksMax=2048
StandardOutput=append:/var/log/dsh/gateway-%i.log
StandardError=append:/var/log/dsh/gateway-%i-error.log

[Install]
WantedBy=multi-user.target
