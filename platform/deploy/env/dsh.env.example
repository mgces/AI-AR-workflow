# Copy to /etc/dsh/dsh.env and replace every deployment value.
# The file must be owned by root:dsh and mode 0640.
DSH_HOME=/var/lib/dsh
DSH_STATE_ROOT=/var/lib/dsh/runtime
DSH_REPO_ROOT=/srv/dsh/workspaces/default/project
# These two paths are consumed by dsh-doctor. The shipped systemd unit pins
# the same canonical paths directly because ExecStart must not depend on
# EnvironmentFile variable expansion.
DSH_PATCH_FILE=/opt/dsh/AI-AR-workflow/platform/deploy/cordis.cloud.patch.yml
DSH_DSH_COMMAND=/opt/dsh/official/node_modules/.bin/dsh
DSH_DELIVERY_SCRIPTS_ROOT=/opt/dsh/AI-AR-workflow/skills/ohos-ar-dev-phases/scripts
DSH_DELIVERY_BRIDGE=/opt/dsh/AI-AR-workflow/runtime/dsh-ohos/src/workflows/ar-delivery/python/delivery_bridge.py
DSH_ENVIRONMENT=openharmony
DSH_ENV_PROFILE_FILE=
DSH_CODEAGENT_COMMAND=/usr/local/bin/claude
DSH_PYTHON_COMMAND=/usr/bin/python3
DSH_GIT_COMMAND=/usr/bin/git
DSH_HDC_COMMAND=/usr/local/bin/hdc
DSH_PUBLISH_COMMAND=/usr/local/bin/oh-gc
# Must equal DSH_GATEWAY_BEARER_TOKEN in the corresponding Gateway env file.
# The cloud plugin resolves this reference for HTTP envelope requests.
DSH_GATEWAY_BEARER_TOKEN=
# Authority envelope HMAC secret. It must equal DSH_GATEWAY_SHARED_SECRET in
# the corresponding Gateway EnvironmentFile. Keep this in the cloud secret
# store; the deployment doctor checks that both sides are configured and
# matching without printing the value.
DSH_AUTHORITY_SHARED_SECRET=
# Optional local-Connector transport token. Required when the canonical patch
# has localConnector.enabled=true; keep it in the cloud secret store and use
# the same value in the user's Connector config.
DSH_CONNECTOR_TOKEN=

# ProcessSupervisor isolation. Keep best_effort until the service cgroup is
# delegated and the doctor reports a writable cgroup v2 root; then change to
# required so an operation cannot start without the requested isolation.
DSH_PROCESS_CGROUP_MODE=best_effort
# "self" resolves to the service's delegated cgroup subtree (recommended).
DSH_PROCESS_CGROUP_ROOT=self
DSH_PROCESS_CGROUP_PREFIX=dsh
# Optional cgroup v2 limits, for example:
# DSH_PROCESS_MEMORY_MAX=8589934592
# DSH_PROCESS_PIDS_MAX=512
# DSH_PROCESS_CPU_MAX=200000 100000

# Official DSH profile and patch are configured in the systemd unit. Secrets
# such as provider tokens, Gateway HMAC and SSH keys come from the host secret
# store and must not be committed here.
