# One file per registered SSH workspace, referenced by dsh-workspace-gateway@.service.
DSH_GATEWAY_HOST=code-host.example
DSH_GATEWAY_USER=builder
DSH_GATEWAY_PORT=22
DSH_GATEWAY_REMOTE_ROOT=/srv/project
DSH_GATEWAY_IDENTITY_FILE=/var/lib/dsh/secrets/id_ed25519
DSH_GATEWAY_KNOWN_HOSTS_FILE=/var/lib/dsh/secrets/known_hosts
DSH_TENANT_ID=tenant-1
DSH_WORKSPACE_ID=workspace-1
DSH_GATEWAY_LOCK_DB=/var/lib/dsh/gateway/resource-locks.sqlite3
DSH_GATEWAY_JOURNAL_DB=/var/lib/dsh/gateway/operations.sqlite3
# Keep fixed CodeAgent and AR gate argv templates in a root-owned file instead
# of putting a large JSON document in EnvironmentFile. The gateway validates
# this path and rejects relative paths or simultaneous inline/file settings.
DSH_GATEWAY_PROFILES_FILE=/opt/dsh/AI-AR-workflow/workspace-gateway/examples/ar-delivery-profiles.json
# Inline JSON remains available for a deliberately self-contained install:
# DSH_GATEWAY_PROFILES=
DSH_GATEWAY_HTTP_HOST=127.0.0.1
DSH_GATEWAY_HTTP_PORT=8790
# Generate a long random value in the secret store; do not commit it.
DSH_GATEWAY_SHARED_SECRET=
# Must equal DSH_GATEWAY_BEARER_TOKEN in /etc/dsh/dsh.env.
DSH_GATEWAY_BEARER_TOKEN=

# Optional per-operation cgroup controls. Use required only after the host
# delegates a writable cgroup v2 subtree to the dsh service user.
DSH_PROCESS_CGROUP_MODE=best_effort
DSH_PROCESS_CGROUP_ROOT=self
DSH_PROCESS_CGROUP_PREFIX=dsh-gateway
