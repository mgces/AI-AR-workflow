# Public DNS A/AAAA records must point here before Caddy can issue HTTPS certificates.
DSH_CLOUD_DOMAIN=cloud.example.com
DSH_CLOUD_PUBLIC_ORIGIN=https://cloud.example.com

# Generate unique values for this deployment; never commit the resulting .env.
DSH_CLOUD_PROXY_AUTH_SECRET=CHANGE_ME
DSH_CLOUD_TENANT_ID=team-example
DSH_CLOUD_WORKSPACE_IDS=
DSH_CLOUD_ADMIN_USERS=admin@example.com

# OAuth2 Proxy / OIDC provider settings.
OAUTH2_PROXY_OIDC_ISSUER_URL=https://identity.example.com/realms/team
OAUTH2_PROXY_CLIENT_ID=dsh-cloud-console
OAUTH2_PROXY_CLIENT_SECRET=replace-with-oidc-client-secret
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64url-cookie-secret
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
