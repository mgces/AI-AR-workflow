---
# Executable clang-tidy configuration. The OpenHarmony rule mapping lives only
# in code_ruleset_guard.py; custom YAML keys are intentionally not used here.
Checks: '-*,google-explicit-constructor,cppcoreguidelines-special-member-functions,cppcoreguidelines-virtual-class-destructor,performance-noexcept-move-constructor,modernize-use-override,cppcoreguidelines-pro-type-member-init,cppcoreguidelines-pro-type-cstyle-cast,cppcoreguidelines-no-malloc,cppcoreguidelines-owning-memory,google-readability-casting,readability-const-return-type,readability-inconsistent-declaration-parameter-name,misc-unused-parameters,misc-throw-by-value-catch-by-reference,misc-redundant-expression,misc-misleading-identifier,performance-move-const-arg,llvm-header-guard,google-global-names-in-headers,bugprone-reserved-identifier,bugprone-macro-parentheses,bugprone-multiple-statement-macro,bugprone-macro-repeated-side-effects,bugprone-undefined-memory-manipulation,bugprone-infinite-loop,bugprone-exception-escape,bugprone-branch-clone,clang-analyzer-core.*,clang-analyzer-cplusplus.*,clang-analyzer-security.insecureAPI.*,clang-analyzer-optin.portability.UnixAPI,clang-analyzer-unix.Malloc,clang-analyzer-valist.*'
CheckOptions:
  - key: google-readability-function-size.LineWidth
    value: '120'
  - key: google-readability-function-size.StatementThreshold
    value: '50'
  - key: google-readability-function-size.ParameterThreshold
    value: '5'
  - key: google-readability-function-size.NestingThreshold
    value: '4'
  - key: bugprone-macro-parentheses.IgnoreKeywordsWithArguments
    value: '0'
  - key: modernize-use-override.IgnoreDestructors
    value: '0'
  - key: modernize-use-override.AllowOverrideAndFinal
    value: '1'
  - key: llvm-header-guard.HeaderFileExtensions
    value: '.h,.hh,.hpp,.hxx'
