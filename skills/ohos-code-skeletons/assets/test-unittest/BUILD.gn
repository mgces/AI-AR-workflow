# SKELETON: ohos_unittest BUILD.gn. Replace <...> placeholders (README.md).
# MANDATORY: import("//build/test.gni") — provides the ohos_unittest template.
import("//build/test.gni")

module_output_path = "<PART_NAME>/<MODULE_OUT_SUBDIR>"

config("<test_target>_config") {
  visibility = [ ":*" ]
  include_dirs = [
    ".",
    "<INCLUDE_DIR_UNDER_TEST>",
  ]
}

ohos_unittest("<TEST_TARGET>") {
  testonly = true
  module_out_path = module_output_path
  configs = [ ":<test_target>_config" ]

  sources = [ "<target>_test.cpp" ]

  deps = [
    # the production target under test (or a *_for_test static lib variant)
    "<DEP_UNDER_TEST>",
  ]
  external_deps = [
    "googletest:gtest_main",
    "hilog:libhilog",
  ]
}

# developer_test entry: `./start.sh run -t UT -tp <PART_NAME> -ts <TEST_TARGET>`
group("unittest") {
  testonly = true
  deps = [ ":<TEST_TARGET>" ]
}
