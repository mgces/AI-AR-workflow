# SKELETON: ohos_moduletest BUILD.gn. Replace <...> placeholders (README.md).
import("//build/test.gni")

module_output_path = "<PART_NAME>/<MODULE_OUT_SUBDIR>"

ohos_moduletest("<MTEST_TARGET>") {
  testonly = true
  module_out_path = module_output_path
  include_dirs = [
    ".",
    "<INCLUDE_DIR_UNDER_TEST>",
  ]
  sources = [ "<target>_module_test.cpp" ]
  deps = [ "<DEP_UNDER_TEST>" ]
  external_deps = [
    "googletest:gtest_main",
    "hilog:libhilog",
  ]
}

# developer_test entry: `./start.sh run -t MST -tp <PART_NAME> -ts <MTEST_TARGET>`
group("moduletest") {
  testonly = true
  deps = [ ":<MTEST_TARGET>" ]
}
