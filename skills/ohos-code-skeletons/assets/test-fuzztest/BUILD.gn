# SKELETON: ohos_fuzztest BUILD.gn. Replace <...> placeholders (README.md).
import("//build/test.gni")

module_output_path = "<PART_NAME>/<MODULE_OUT_SUBDIR>"

ohos_fuzztest("<FUZZ_TARGET>") {
  module_out_path = module_output_path
  fuzz_config_file = "<fuzzer_dir>"
  include_dirs = [
    ".",
    "<INCLUDE_DIR_UNDER_TEST>",
  ]
  sources = [ "<target>_fuzzer.cpp" ]
  deps = [ "<DEP_UNDER_TEST>" ]
  external_deps = [ "hilog:libhilog" ]
}

group("fuzztest") {
  testonly = true
  deps = [ ":<FUZZ_TARGET>" ]
}
